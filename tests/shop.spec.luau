local Transactions = require("../src/ServerScriptService/Shop/Transactions")
local shaq = { id = "hof-shaquille-oneal-1991-92", price = 400000 }
local start = Transactions.newProfile(1000000)
local bought, code = Transactions.purchase(start, shaq)
assert(code == "PURCHASED" and bought.balance == 600000 and bought.shopUnlocked[shaq.id] and not bought.owned[shaq.id])
assert(start.balance == 1000000 and not start.owned[shaq.id], "Must not mutate the pre-commit profile")
local duplicate, duplicateCode = Transactions.purchase(bought, shaq)
assert(duplicateCode == "ELIGIBLE" and duplicate.balance == 600000, "Duplicate/retried request must not charge twice")
local poor = Transactions.newProfile(399999)
local rejected, rejectedCode = Transactions.purchase(poor, shaq)
assert(rejectedCode == "INSUFFICIENT" and rejected.balance == 399999 and not rejected.owned[shaq.id])
local exact, exactCode = Transactions.purchase(Transactions.newProfile(400000), shaq)
assert(exactCode == "PURCHASED" and exact.balance == 0)
local other = { id = "other", price = 700000 }
local nextState, nextCode = Transactions.purchase(bought, other)
assert(nextCode == "INSUFFICIENT" and nextState.shopUnlocked[shaq.id] and not nextState.owned.other)
local independent = Transactions.newProfile(1000000)
assert(not independent.shopUnlocked[shaq.id], "Players must not share ownership")
print("Shop transactions: purchase, exact balance, insufficient funds, retry, immutability, and player isolation passed")
