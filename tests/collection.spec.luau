local Transactions = require("../src/ServerScriptService/Shop/Transactions")
local profile = Transactions.startSession(Transactions.newProfile(1000), "session")
local locked, code = Transactions.equip(profile, "locked")
assert(code == "LOCKED" and locked == profile)
local invalid, invalidCode = Transactions.equip(profile, {})
assert(invalidCode == "LOCKED" and invalid == profile)
local purchased = Transactions.purchase(profile, { id = "playerA", price = 100 })
assert(select(2, Transactions.equip(purchased,"playerA"))=="LOCKED")
purchased=Transactions.unlock(purchased,"playerA",100)
local equipped, equipCode = Transactions.equip(purchased, "playerA")
assert(equipCode == "EQUIPPED" and equipped.equippedCardId == "playerA")
assert(purchased.equippedCardId == nil and equipped.balance == 900)
assert(equipped.sessionUnlocks == 1)
local reconnect = Transactions.startSession(equipped, "new-session")
assert(reconnect.equippedCardId == "playerA" and reconnect.owned.playerA)
local second = Transactions.purchase(reconnect, { id = "playerB", price = 100 })
assert(second.equippedCardId == "playerA", "Purchasing should preserve selection")
second=Transactions.unlock(second,"playerB",100)
local switched = Transactions.equip(second, "playerB")
assert(switched.equippedCardId == "playerB" and switched.owned.playerA and switched.owned.playerB)
local rejected, rejection = Transactions.equip(switched, "unowned")
assert(rejection == "LOCKED" and rejected.equippedCardId == "playerB")
local advanced = Transactions.advanceSession(switched, "new-session", 10)
assert(advanced.equippedCardId == "playerB")
print("Collection: locked/invalid rejection, ownership, immutable equip, switching, purchase preservation, reconnect and checkpoint persistence passed")
