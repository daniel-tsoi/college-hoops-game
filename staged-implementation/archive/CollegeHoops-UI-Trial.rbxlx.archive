					<ProtectedString name="Source"><![CDATA[-- Staged implementation / Feature 1: standalone interface only.
-- Paste into a LocalScript named HoopsUI under StarterPlayerScripts.
-- Studio preview counters are disposable. Real actions require a future server feature.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
if playerGui:FindFirstChild("CollegeHoopsUI") then
	return -- Prevent duplicate copies of this interface.
end
local preview = RunService:IsStudio()
local colors = {
	background = Color3.fromRGB(15, 20, 29),
	panel = Color3.fromRGB(25, 33, 46),
	button = Color3.fromRGB(43, 56, 74),
	accent = Color3.fromRGB(100, 229, 170),
	danger = Color3.fromRGB(242, 135, 135),
	text = Color3.fromRGB(241, 244, 249),
	muted = Color3.fromRGB(168, 181, 199),
}
local function create(className, parent, properties)
	local object = Instance.new(className)
	for key, value in pairs(properties) do
		object[key] = value
	end
	object.Parent = parent
	return object
end
local function round(object)
	create("UICorner", object, { CornerRadius = UDim.new(0, 3) })
end
local gui = create("ScreenGui", playerGui, {
	Name = "CollegeHoopsUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 10,
	ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
})
local background = create("Frame", gui, {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Visible = false,
	BorderSizePixel = 0,
})
local build = create("TextButton", gui, {
	Name = "Build",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.new(1, -32, 0, 64),
	Text = "Build Your Squad",
	Font = Enum.Font.GothamBold,
	TextSize = 20,
	BackgroundColor3 = Color3.fromRGB(8, 12, 12),
	TextColor3 = colors.text,
	BorderSizePixel = 0,
	Visible = true,
	Selectable = true,
})
round(build)
create("UISizeConstraint", build, { MaxSize = Vector2.new(320, 64) })
create("UIStroke", build, {
	ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	Thickness = 2,
	Color = Color3.fromRGB(83, 220, 133),
})
-- A fixed design canvas scales to the available safe area: no scrolling.
local canvas = create("Frame", background, {
	Name = "SquadCanvas",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(1120, 680),
	BackgroundTransparency = 1,
})
local canvasScale = create("UIScale", canvas, { Scale = 1 })
local function fitCanvas()
	local size = background.AbsoluteSize
	canvasScale.Scale = math.min(size.X / 1120, size.Y / 680)
end
local resizeConnection = background:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitCanvas)
fitCanvas()
local function textAt(parent, name, text, x, y, width, height, size, color)
	return create("TextLabel", parent, {
		Name = name,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color or colors.text,
		Font = Enum.Font.GothamBold,
		TextWrapped = true,
		TextStrokeTransparency = 0.5,
	})
end
local function outline(object, color)
	create("UIStroke", object, {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Thickness = 2,
		Color = color or colors.accent,
	})
end
textAt(canvas, "Title", "BUILD YOUR\nSQUAD", 24, 18, 280, 100, 38)
textAt(canvas, "Mode", preview and "STUDIO UI PREVIEW" or "UI ONLY", 24, 120, 280, 24, 14, colors.accent)
local counters = textAt(canvas, "Counters", "", 24, 147, 280, 40, 15)
local actions = create("Frame", canvas, {
	Name = "Actions",
	Position = UDim2.fromOffset(44, 202),
	Size = UDim2.fromOffset(240, 422),
	BackgroundTransparency = 1,
})
create("UIListLayout", actions, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
local buttons = {}
local actionNames = { "Roll", "Reroll", "Refresh", "Accept", "Finish Squad", "Restart", "Exit" }
for index, name in ipairs(actionNames) do
	local button = create("TextButton", actions, {
		Name = name:gsub(" ", ""),
		LayoutOrder = index,
		Size = UDim2.fromOffset(240, 50),
		Text = name:upper(),
		BackgroundColor3 = Color3.fromRGB(8, 12, 12),
		BackgroundTransparency = 0.12,
		TextColor3 = colors.text,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Selectable = true,
	})
	round(button)
	outline(button, (name == "Restart" or name == "Exit") and colors.danger or colors.accent)
	buttons[name] = button
end
textAt(canvas, "Overall", "TEAM OVR: —   |   CHEMISTRY: —", 340, 16, 748, 40, 26)
textAt(canvas, "SchoolSeason", "School & season: awaiting game system", 340, 61, 748, 28, 16)
local court = create("Frame", canvas, {
	Name = "CurrentPlayers",
	Position = UDim2.fromOffset(340, 100),
	Size = UDim2.fromOffset(748, 366),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
})
outline(court)
local lineup = textAt(court, "LineupCount", "", 12, 6, 724, 26, 17)
local positions = { "PG", "SG", "SF", "PF", "C" }
local slotLocations =
	{ Vector2.new(184, 44), Vector2.new(414, 44), Vector2.new(70, 204), Vector2.new(299, 204), Vector2.new(528, 204) }
local slots = {}
for index, position in ipairs(positions) do
	local point = slotLocations[index]
	local card = textAt(court, position, position .. "\n\nEMPTY", point.X, point.Y, 150, 140, 21)
	card.BackgroundColor3 = colors.panel
	card.BackgroundTransparency = 0.24
	card.BorderSizePixel = 0
	round(card)
	outline(card, colors.muted)
	slots[index] = card
end
textAt(canvas, "CandidatesTitle", "CANDIDATES", 340, 477, 350, 24, 16)
for index = 1, 3 do
	local card =
		textAt(canvas, "Candidate" .. index, "?\nCandidate " .. index, 340 + (index - 1) * 120, 509, 108, 100, 17)
	card.BackgroundColor3 = colors.panel
	card.BackgroundTransparency = 0.24
	card.BorderSizePixel = 0
	round(card)
end
local reveal = textAt(canvas, "RevealedCard", "REVEALED CARD\nNo player rolled yet.", 714, 486, 374, 123, 18)
reveal.BackgroundColor3 = colors.panel
reveal.BackgroundTransparency = 0.24
reveal.BorderSizePixel = 0
round(reveal)
outline(reveal)
local status = textAt(
	canvas,
	"Status",
	"UI preview: Roll and Accept test slots. No real cards or saving yet.",
	340,
	622,
	748,
	46,
	16
)
status.BackgroundColor3 = colors.panel
status.BackgroundTransparency = 0.15
status.BorderSizePixel = 0

local overlay = create("TextButton", gui, {
	Name = "ConfirmationOverlay",
	Size = UDim2.fromScale(1, 1),
	Text = "",
	BackgroundColor3 = Color3.new(),
	BackgroundTransparency = 0.25,
	AutoButtonColor = false,
	Selectable = false,
	Visible = false,
	ZIndex = 20,
	Modal = true,
})
local dialog = create("Frame", overlay, {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(1, -32, 0, 224),
	BackgroundColor3 = colors.panel,
	BorderSizePixel = 0,
	ZIndex = 21,
})
round(dialog)
create("UISizeConstraint", dialog, { MaxSize = Vector2.new(460, 224) })
local dialogText = create("TextLabel", dialog, {
	Position = UDim2.fromOffset(16, 16),
	Size = UDim2.new(1, -32, 0, 124),
	BackgroundTransparency = 1,
	TextColor3 = colors.text,
	TextSize = 18,
	Font = Enum.Font.GothamMedium,
	TextWrapped = true,
	ZIndex = 22,
	Text = "RESTART PREVIEW?\n\nClears this UI preview and sets Rerolls and Refreshes to 1 each. No real team or collection exists yet.",
})
local function dialogButton(text, x)
	local button = create("TextButton", dialog, {
		Position = UDim2.new(x, 12, 1, -68),
		Size = UDim2.new(0.5, -24, 0, 52),
		Text = text,
		TextColor3 = colors.text,
		BackgroundColor3 = colors.button,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		BorderSizePixel = 0,
		ZIndex = 22,
		Selectable = true,
	})
	round(button)
	return button
end
local cancel = dialogButton("CANCEL", 0)
local confirm = dialogButton("RESTART", 0.5)
local freeRerolls, freeRefreshes = 1, 1
local filled, hasReveal, finished = 0, false, false
local pendingAction = nil
local returnFocus = nil
local function setModal(open)
	overlay.Visible = open
	for _, button in pairs(buttons) do
		button.Selectable = not open
		button.Active = not open
	end
end
local function updateCounters()
	counters.Text = preview and string.format("Free Rerolls: %d   |   Free Refreshes: %d", freeRerolls, freeRefreshes)
		or "Free actions: awaiting server"
end
local function render()
	updateCounters()
	buttons.Reroll.Text = preview and string.format("REROLL  |  %d FREE", freeRerolls) or "REROLL"
	buttons.Refresh.Text = preview and string.format("REFRESH  |  %d FREE", freeRefreshes) or "REFRESH"
	buttons["Finish Squad"].Text = string.format("FINISH SQUAD  |  %d / 5", filled)
	lineup.Text = string.format("CURRENT PLAYERS  |  %d / 5 preview slots", filled)
	for index, slot in ipairs(slots) do
		slot.Text = positions[index] .. (index <= filled and "\n\nTEST CARD" or "\n\nEMPTY")
		slot.TextColor3 = index <= filled and colors.accent or colors.text
	end
end
local function closeDialog()
	setModal(false)
	pendingAction = nil
	GuiService.SelectedObject = returnFocus
end
local function openDialog(action, text)
	pendingAction = action
	returnFocus = GuiService.SelectedObject
	dialogText.Text = text
	confirm.Text = action == "Restart" and "RESTART" or "FINISH PREVIEW"
	setModal(true)
	GuiService.SelectedObject = cancel
end
cancel.NextSelectionLeft = confirm
cancel.NextSelectionRight = confirm
cancel.NextSelectionUp = confirm
cancel.NextSelectionDown = confirm
confirm.NextSelectionLeft = cancel
confirm.NextSelectionRight = cancel
confirm.NextSelectionUp = cancel
confirm.NextSelectionDown = cancel
local function restartPreview()
	freeRerolls, freeRefreshes = 1, 1
	filled, hasReveal, finished = 0, false, false
	reveal.Text = "REVEALED CARD\nNo player rolled yet."
	status.Text = "Preview restarted. Both free counters are exactly 1. School selection comes later."
	render()
end
cancel.Activated:Connect(closeDialog)
confirm.Activated:Connect(function()
	if not overlay.Visible then
		return
	end
	local action = pendingAction
	closeDialog()
	if action == "Restart" then
		restartPreview()
	elseif action == "Finish Squad" and filled == 5 and not finished then
		finished = true
		status.Text = "Preview finished. Nothing was saved or banked. Restart to test again."
	end
end)
for name, button in pairs(buttons) do
	button.Activated:Connect(function()
		if overlay.Visible then
			return
		end
		if name == "Exit" then
			background.Visible = false
			build.Visible = true
			GuiService.SelectedObject = build
			return
		end
		if not preview then
			status.Text = "UI ready. Server actions will be connected in a later feature."
			return
		end
		if name == "Restart" then
			if filled > 0 and not finished then
				openDialog(
					name,
					string.format(
						"RESTART PREVIEW?\n\nDiscard %d temporary preview slots and the revealed placeholder. Reset both free counters to 1. No saved collection exists in this preview.",
						filled
					)
				)
			else
				restartPreview()
			end
		elseif finished then
			status.Text = "Preview finished. Restart to begin another UI test."
		elseif name == "Reroll" or name == "Refresh" then
			if name == "Reroll" and not hasReveal then
				status.Text = "Roll a preview placeholder before testing Reroll."
				return
			end
			local remaining = name == "Reroll" and freeRerolls or freeRefreshes
			if remaining == 0 then
				status.Text = "No free " .. name .. " remaining. Paid actions are not implemented."
				return
			end
			if name == "Reroll" then
				freeRerolls -= 1
			else
				freeRefreshes -= 1
			end
			render()
			status.Text = name == "Reroll"
					and "Reroll preview: one counter used. Real individual replacement comes later."
				or "Refresh preview: one counter used. Real candidate replacement comes later."
		elseif name == "Roll" then
			if filled == 5 or hasReveal then
				status.Text = "Accept the current placeholder, or finish the five-slot preview."
				return
			end
			hasReveal = true
			reveal.Text = "REVEALED CARD\nUI test placeholder — not a real player."
			status.Text = "Use Reroll to test its counter, or Accept to fill a preview slot."
		elseif name == "Accept" then
			if not hasReveal or filled >= 5 then
				status.Text = "Roll a placeholder first. The preview holds five slots."
				return
			end
			filled += 1
			hasReveal = false
			reveal.Text = "REVEALED CARD\nNo player rolled yet."
			status.Text = "Preview slot filled. No card was generated or awarded."
			render()
		elseif name == "Finish Squad" then
			if filled < 5 then
				status.Text = "Fill all five preview slots using Roll and Accept first."
				return
			end
			openDialog(
				name,
				"FINISH SQUAD PREVIEW?\n\nEnds this five-slot UI test. This stage does not save cards, collections, or teams."
			)
		end
	end)
end
build.Activated:Connect(function()
	build.Visible = false
	background.Visible = true
	GuiService.SelectedObject = buttons.Roll
end)
local inputConnection = UserInputService.InputBegan:Connect(function(input)
	if overlay.Visible and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
		closeDialog()
	end
end)
gui.Destroying:Connect(function()
	inputConnection:Disconnect()
	resizeConnection:Disconnect()
end)
render()
]]></ProtectedString>
