					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Fictional development seed: 20 cards, 10 Common / 6 Rare / 3 Epic / 1 Legendary.
-- This composition is NOT a roll probability table or the verified NCAA dataset.
-- Ordinary Overall: 1-99; All-NBA: 100-105; HOF: 105-110 (105 overlaps by request).
-- Overall is a provisional card appraisal, not the average of its base attributes.
-- All real-player ratings below are uncalibrated development placeholders.

export type Rarity = "Common" | "Rare" | "Epic" | "Legendary" | "All-NBA" | "HOF"
export type Position = "PG" | "SG" | "SF" | "PF" | "C"

-- Singleton field types preserve enum precision for consumers and the LSP.
local Rarity: {
    Common: "Common",
    Rare: "Rare",
    Epic: "Epic",
    Legendary: "Legendary",
    AllNBA: "All-NBA",
    HOF: "HOF",
} = table.freeze({
    Common = "Common",
    Rare = "Rare",
    Epic = "Epic",
    Legendary = "Legendary",
    AllNBA = "All-NBA",
    HOF = "HOF",
})

export type Attributes = {
    shooting: number,
    dribbling: number,
    defense: number,
    speed: number,
    stamina: number,
}

export type Player = {
    id: string,
    name: string,
    position: Position,
    rarity: Rarity,
    attributes: Attributes,
    statMultiplier: number,
    overall: number,
    sourceType: "EXAMPLE" | "LEGACY_HOF" | "NON_COLLEGE",
    acquisition: "EXAMPLE_ONLY" | "GLOBAL_HOF" | "DIRECT_PURCHASE",
    ratingStatus: "PROVISIONAL",
    schoolSeasonId: string?,
    school: string?,
    season: string?,
    eligiblePositions: { Position }?,
}

-- Attributes are BASE values. Future stat consumers apply the multiplier once:
-- math.clamp(math.round(baseAttribute * player.statMultiplier), 1, 99).
-- Multipliers affect every attribute; no gameplay calculation runs in this module.
local StatMultiplierByRarity: { [Rarity]: number } = table.freeze({
    [Rarity.Common] = 1.00,
    [Rarity.Rare] = 1.05,
    [Rarity.Epic] = 1.10,
    [Rarity.Legendary] = 1.15,
    [Rarity.AllNBA] = 1.20,
    [Rarity.HOF] = 1.25,
})

export type RatingRange = { min: number, max: number }
-- Ordinary cutoffs are prototype balance choices. Special cutoffs are user-specified.
local OverallRangeByRarity: { [Rarity]: RatingRange } = {
    [Rarity.Common] = { min = 1, max = 64 },
    [Rarity.Rare] = { min = 65, max = 79 },
    [Rarity.Epic] = { min = 80, max = 89 },
    [Rarity.Legendary] = { min = 90, max = 99 },
    [Rarity.AllNBA] = { min = 100, max = 105 },
    [Rarity.HOF] = { min = 105, max = 110 },
}
for _, range in OverallRangeByRarity do
    table.freeze(range)
end
table.freeze(OverallRangeByRarity)

