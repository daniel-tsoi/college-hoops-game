}

-- Design section 9.2: these four cards are never members of a random-roll pool.
-- All-NBA is a provisional game tier, not a claim about an award in a given year.
local NonCollegePlayers: { Player } = {
    {
        id = "non-college-kobe-bryant", name = "Kobe Bryant", position = "SG",
        eligiblePositions = { "SG", "SF" },
        rarity = Rarity.AllNBA, overall = 105, attributes = { shooting = 98, dribbling = 95, defense = 94, speed = 91, stamina = 97 },
        statMultiplier = StatMultiplierByRarity[Rarity.AllNBA],
        sourceType = "NON_COLLEGE", acquisition = "DIRECT_PURCHASE", ratingStatus = "PROVISIONAL",
    },
    {
        id = "non-college-lebron-james", name = "LeBron James", position = "SF",
        eligiblePositions = { "SF", "PF", "PG" },
        rarity = Rarity.AllNBA, overall = 105, attributes = { shooting = 90, dribbling = 95, defense = 94, speed = 95, stamina = 99 },
        statMultiplier = StatMultiplierByRarity[Rarity.AllNBA],
        sourceType = "NON_COLLEGE", acquisition = "DIRECT_PURCHASE", ratingStatus = "PROVISIONAL",
    },
    {
        id = "non-college-luka-doncic", name = "Luka Doncic", position = "PG",
        eligiblePositions = { "PG", "SG", "SF" },
        rarity = Rarity.AllNBA, overall = 103, attributes = { shooting = 96, dribbling = 98, defense = 76, speed = 78, stamina = 94 },
        statMultiplier = StatMultiplierByRarity[Rarity.AllNBA],
        sourceType = "NON_COLLEGE", acquisition = "DIRECT_PURCHASE", ratingStatus = "PROVISIONAL",
    },
    {
        id = "non-college-nikola-jokic", name = "Nikola Jokic", position = "C",
        eligiblePositions = { "C", "PF" },
        rarity = Rarity.AllNBA, overall = 104, attributes = { shooting = 93, dribbling = 90, defense = 85, speed = 65, stamina = 97 },
        statMultiplier = StatMultiplierByRarity[Rarity.AllNBA],
        sourceType = "NON_COLLEGE", acquisition = "DIRECT_PURCHASE", ratingStatus = "PROVISIONAL",
    },
}

-- Luau has no integer/range types or compile-time uniqueness constraints.
-- Validate those data invariants at require time; structural mistakes are LSP errors.
local seenIds: { [string]: boolean } = {}
local pools: { { Player } } = { Players, HOFPlayers, NonCollegePlayers }
for _, pool in pools do
    for _, player in pool do
        assert(player.id ~= "" and not seenIds[player.id], "Empty or duplicate player ID: " .. player.id)
        seenIds[player.id] = true
        for attribute, value in player.attributes do
            assert(value >= 1 and value <= 99 and value % 1 == 0,
                player.id .. ": " .. attribute .. " must be an integer in 1-99")
        end
        local range = OverallRangeByRarity[player.rarity]
        assert(player.overall % 1 == 0 and player.overall >= range.min and player.overall <= range.max,
            player.id .. ": Overall outside rarity band")
        if player.sourceType == "NON_COLLEGE" then
            assert(player.acquisition == "DIRECT_PURCHASE" and player.schoolSeasonId == nil,
                player.id .. ": non-college cards must be purchase-only without a school-season")
        elseif player.sourceType == "LEGACY_HOF" then
            assert(player.schoolSeasonId ~= nil and player.rarity == Rarity.HOF,
                player.id .. ": HOF reference requires historical school-season metadata")
        end
        if player.eligiblePositions then
            table.freeze(player.eligiblePositions)
        end
        table.freeze(player.attributes)
        table.freeze(player)
    end
    table.freeze(pool)
end

return table.freeze({
    Rarity = Rarity,
    StatMultiplierByRarity = StatMultiplierByRarity,
    OverallRangeByRarity = OverallRangeByRarity,
    Players = Players,
    HOFPlayers = HOFPlayers,
    NonCollegePlayers = NonCollegePlayers,
})
