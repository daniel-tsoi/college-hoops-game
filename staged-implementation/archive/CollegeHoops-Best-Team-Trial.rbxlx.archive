      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">PlayerTypes</string>
          <string name="Source"><![CDATA[--!strict
-- Shared enum, data shapes, and balance constants. No game actions.
export type Rarity = "Common" | "Rare" | "Epic" | "Legendary" | "All-Star" | "HOF"
export type Position = "PG" | "SG" | "SF" | "PF" | "C"
export type Attributes = { shooting: number, dribbling: number, defense: number, speed: number, stamina: number }
export type SourceStats = {
    gamesPlayed: number,
    gamesStarted: number?, minutes: number?, fgm: number?, fga: number?,
    threeMade: number?, threeAttempted: number?, ftm: number?, fta: number?,
    offensiveRebounds: number?, defensiveRebounds: number?, rebounds: number?,
    assists: number?, steals: number?, blocks: number?, turnovers: number?, fouls: number?, points: number?,
}
export type Player = {
    id: string, playerId: string, name: string, position: Position,
    rarity: Rarity, overall: number, attributes: Attributes, statMultiplier: number,
    sourceType: "COLLEGE" | "LEGACY_HOF" | "NON_COLLEGE",
    acquisition: "SCHOOL_SEASON" | "GLOBAL_HOF" | "DIRECT_PURCHASE",
    variant: "BASE" | "ALL_STAR_SEASON" | "HOF" | "NON_COLLEGE",
    ratingStatus: "DERIVED_ESTIMATE" | "MANUAL_ESTIMATE",
    ratingModelVersion: string, dataConfidence: "LOW" | "MEDIUM",
    positionConfidence: "SOURCE" | "ESTIMATED" | "LOW",
    speedBasis: "POSITION_PRIOR_NOT_MEASURED" | "MANUAL_ARCHETYPE_NOT_MEASURED",
    sourcePosition: string?, sourceId: string?, sourceUrls: { string }?, sourceStats: SourceStats?,
    schoolSeasonId: string?, school: string?, season: string?,
    eligiblePositions: { Position }, baseCardId: string?, eligibilityBasis: string?,
    defaultUnlocked: boolean?,
}
export type SchoolSeason = {
    id: string, school: string, teamName: string, season: string, sourceTeamId: string,
    recordedGames: number, rosterCardIds: { string }, allStarCardIds: { string },
    coverageStatus: "BOX_SCORES_IMPORTED_NOT_FULLY_AUDITED",
    hasLegalLineup: boolean, hasAllStarPool: boolean, releaseReady: boolean,
}
export type RatingRange = { min: number, max: number }
local Rarity: {
    Common: "Common", Rare: "Rare", Epic: "Epic", Legendary: "Legendary", AllStar: "All-Star", HOF: "HOF",
} = { Common = "Common", Rare = "Rare", Epic = "Epic", Legendary = "Legendary", AllStar = "All-Star", HOF = "HOF" }
table.freeze(Rarity)
local StatMultiplierByRarity: { [Rarity]: number } = table.freeze({
    [Rarity.Common] = 1, [Rarity.Rare] = 1.05, [Rarity.Epic] = 1.10,
    [Rarity.Legendary] = 1.15, [Rarity.AllStar] = 1.20, [Rarity.HOF] = 1.25,
})
-- These bands apply to Overall, not measured box scores or base attributes.
-- The shared endpoint 105 is intentional. Read rarity explicitly.
local OverallRangeByRarity: { [Rarity]: RatingRange } = {
    [Rarity.Common] = { min = 1, max = 64 }, [Rarity.Rare] = { min = 65, max = 79 },
    [Rarity.Epic] = { min = 80, max = 89 }, [Rarity.Legendary] = { min = 90, max = 99 },
    [Rarity.AllStar] = { min = 100, max = 105 }, [Rarity.HOF] = { min = 105, max = 110 },
}
for _, range in OverallRangeByRarity do table.freeze(range) end
table.freeze(OverallRangeByRarity)
return table.freeze({ Rarity = Rarity, StatMultiplierByRarity = StatMultiplierByRarity, OverallRangeByRarity = OverallRangeByRarity })
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ShopCatalog</string>
          <string name="Source"><![CDATA[-- Shop prices are game-balance choices; ratings come from the existing catalog.
local data = script.Parent.PlayerData
local offers = {}
local byId = {}
local pricing = {
	-- College-season impact, with Shaq as the $400k anchor.
	["hof-magic-johnson-1978-79"] = { 375000, "32", Color3.fromRGB(35, 119, 83) }, -- Magic
	["hof-michael-jordan-1983-84"] = { 350000, "23", Color3.fromRGB(110, 186, 232) }, -- Jordan
	["hof-shaquille-oneal-1991-92"] = { 400000, "33", Color3.fromRGB(113, 67, 169) }, -- Shaq
	["hof-oscar-robertson-1959-60"] = { 450000, "12", Color3.fromRGB(197, 49, 67) }, -- Oscar
	["hof-pete-maravich-1969-70"] = { 425000, "23", Color3.fromRGB(113, 67, 169) }, -- Pete
	["hof-jayson-tatum-2016-17"] = { 175000, "0", Color3.fromRGB(54, 100, 215) }, -- Tatum
	["hof-derrick-rose-2007-08"] = { 225000, "23", Color3.fromRGB(63, 119, 218) }, -- Rose
	["hof-kyrie-irving-2010-11"] = { 150000, "1", Color3.fromRGB(54, 100, 215) }, -- Kyrie
	-- No college season: separately balanced premium unlocks.
	["non-college-kobe-bryant"] = { 425000, "24", Color3.fromRGB(128, 78, 195) },
	["non-college-lebron-james"] = { 450000, "23", Color3.fromRGB(199, 76, 87) },
	["non-college-luka-doncic"] = { 325000, "77", Color3.fromRGB(56, 132, 207) },
	["non-college-nikola-jokic"] = { 375000, "15", Color3.fromRGB(48, 108, 149) },
}
for _, pool in ipairs({ require(data.GeneratedHof001), require(data.GeneratedNonCollege001) }) do
	for _, player in ipairs(pool) do
		local price = assert(pricing[player.id], "Missing shop price: " .. player.id)
		local offer = table.freeze({
			id = player.id, player = player, price = price[1], number = price[2], color = price[3],
			group = player.sourceType == "NON_COLLEGE" and "NON-COLLEGE" or "HOF",
		})
		table.insert(offers, offer)
		byId[offer.id] = offer
	end
end
return table.freeze({ Offers = table.freeze(offers), ById = table.freeze(byId) })
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Config</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">NonCollegeCatalog</string>
          <string name="Source"><![CDATA[--!strict
-- Permanent direct-purchase entitlements. All four start locked.
-- Real game-pass/product identifiers and a verified server purchase handler are
-- required before enabling checkout. Nil IDs are deliberate, never dummy products.
export type Product = {
    cardId: string, displayName: string, acquisition: "DIRECT_PURCHASE",
    defaultUnlocked: boolean, randomEligible: boolean,
    productId: number?, enabled: boolean,
}
local Products: { Product } = {
    { cardId = "non-college-kobe-bryant", displayName = "Kobe Bryant", acquisition = "DIRECT_PURCHASE", defaultUnlocked = false, randomEligible = false, enabled = false },
    { cardId = "non-college-lebron-james", displayName = "LeBron James", acquisition = "DIRECT_PURCHASE", defaultUnlocked = false, randomEligible = false, enabled = false },
    { cardId = "non-college-luka-doncic", displayName = "Luka Doncic", acquisition = "DIRECT_PURCHASE", defaultUnlocked = false, randomEligible = false, enabled = false },
    { cardId = "non-college-nikola-jokic", displayName = "Nikola Jokic", acquisition = "DIRECT_PURCHASE", defaultUnlocked = false, randomEligible = false, enabled = false },
}
for _, product in Products do table.freeze(product) end
return table.freeze({ Products = table.freeze(Products), RequireVerifiedServerEntitlement = true })
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">SummonConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Exact, mutually exclusive tier configuration for the future server summon service.
-- A uniform integer in [1, 800] has ONE HOF result, EIGHT All-Star results,
-- and 791 ordinary results. Never roll independent HOF and All-Star checks.
-- This ModuleScript does not draw a random number, charge, spawn, or grant a card.
export type Outcome = "HOF" | "All-Star" | "Ordinary"
export type TicketRange = { first: number, last: number, count: number }
local Tickets: { [Outcome]: TicketRange } = {
    HOF = { first = 1, last = 1, count = 1 },
    ["All-Star"] = { first = 2, last = 9, count = 8 },
    Ordinary = { first = 10, last = 800, count = 791 },
}
for _, range in Tickets do table.freeze(range) end
local HOFCardIds = table.freeze({
    "hof-magic-johnson-1978-79", "hof-michael-jordan-1983-84",
    "hof-shaquille-oneal-1991-92", "hof-oscar-robertson-1959-60",
    "hof-pete-maravich-1969-70", "hof-jayson-tatum-2016-17",
    "hof-derrick-rose-2007-08", "hof-kyrie-irving-2010-11",
})
return table.freeze({
    Denominator = 800,
    Tickets = table.freeze(Tickets),
    HOFChance = 1 / 800,
    AllStarChance = 1 / 100,
    HOFCardIds = HOFCardIds,
    HOFSelection = "UNIFORM", -- a specific HOF card is 1/6400 overall
    AllStarPool = "CURRENT_SCHOOL_SEASON",
    RequireNonEmptyAllStarPool = true,
    RequireReleaseReadySchoolSeason = true,
    EmptyPoolPolicy = "BLOCK_BEFORE_CHARGE_OR_RANDOM_DRAW",
    ExcludedSourceTypes = table.freeze({ "NON_COLLEGE" }),
})
]]></string>
        </Properties>
