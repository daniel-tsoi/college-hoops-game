    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Shop</string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">BestTeam</string>
          <string name="Source"><![CDATA[-- Highest-rated owned cards, with only one version of each player in the five.
local BestTeam = {}
function BestTeam.select(owned, playersById)
	local candidates = {}
	for id, unlocked in pairs(owned) do
		if unlocked == true and playersById[id] then
			table.insert(candidates, playersById[id])
		end
	end
	table.sort(candidates, function(a, b)
		if a.overall ~= b.overall then return a.overall > b.overall end
		return a.id < b.id
	end)
	local team, seen, total = {}, {}, 0
	for _, card in ipairs(candidates) do
		local identity = card.playerId or card.id
		if not seen[identity] then
			seen[identity] = true
			table.insert(team, { id = card.id, name = card.name, position = card.position,
				overall = card.overall, rarity = card.rarity })
			total += card.overall
			if #team == 5 then break end
		end
	end
	return { players = team, overall = #team > 0 and math.floor(total / #team + 0.5) or 0 }
end
return BestTeam
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Transactions</string>
          <string name="Source"><![CDATA[-- Pure transaction rules. Caller commits wallet and ownership together.
local Transactions = {}
function Transactions.newProfile(balance)
	return { version = 1, balance = balance, owned = {} }
end
function Transactions.purchase(profile, offer)
	if profile.owned[offer.id] then
		return profile, "OWNED"
	end
	if profile.balance < offer.price then
		return profile, "INSUFFICIENT"
	end
	local updated = table.clone(profile)
	updated.owned = table.clone(profile.owned)
	updated.balance -= offer.price
	updated.owned[offer.id] = true
	updated.sessionUnlocks = (profile.sessionUnlocks or 0) + 1
	return updated, "PURCHASED"
end
-- Migration preserves existing cash and owned shop cards.
function Transactions.migrate(profile)
	local updated = table.clone(profile)
	updated.version = 3
	updated.playSeconds = profile.playSeconds or 0
	updated.rerolls = profile.rerolls or 0
	updated.refreshes = profile.refreshes or 0
	updated.claimedQuests = table.clone(profile.claimedQuests or {})
	updated.sessionClaimed = table.clone(profile.sessionClaimed or {})
	updated.sessionUnlocks = profile.sessionUnlocks or 0
	updated.sessionRerolls = profile.sessionRerolls or 0
	updated.previewFreeRerolls = profile.previewFreeRerolls or 0
	return updated
end
function Transactions.startSession(profile, sessionId)
	local updated = Transactions.migrate(profile)
	updated.clockSession = sessionId
	updated.sessionSeconds = 0
	updated.sessionClaimed = {}
	updated.sessionUnlocks = 0
	updated.sessionRerolls = 0
	updated.previewFreeRerolls = 1
	return updated
end
function Transactions.advanceSession(profile, sessionId, elapsed)
	local updated = Transactions.migrate(profile)
	-- A newer connection takes over time tracking. Old servers cannot double-count.
	if updated.clockSession ~= sessionId then return updated end
	local seconds = math.max(updated.sessionSeconds or 0, math.floor(elapsed))
	updated.playSeconds += seconds - (updated.sessionSeconds or 0)
	updated.sessionSeconds = seconds
	return updated
end
function Transactions.claim(profile, quest)
	local updated = Transactions.migrate(profile)
	local claimed = quest.scope == "SESSION" and updated.sessionClaimed or updated.claimedQuests
	local progress = quest.scope == "SESSION" and updated[quest.metric] or updated.playSeconds
	local target = quest.scope == "SESSION" and quest.target or quest.seconds
	if claimed[quest.id] then return updated, "CLAIMED" end
	if progress < target then return updated, "NOT_READY" end
	updated.balance += quest.cash
	updated.rerolls += quest.rerolls
	updated.refreshes += quest.refreshes
	claimed[quest.id] = true
	return updated, "REWARDED"
end
function Transactions.spend(profile, resource)
	local updated = Transactions.migrate(profile)
	if resource ~= "rerolls" and resource ~= "refreshes" then return updated, "INVALID" end
	if updated[resource] < 1 then return updated, "EMPTY" end
	updated[resource] -= 1
	if resource == "rerolls" then updated.sessionRerolls += 1 end
	return updated, "SPENT"
end
-- These two operations are exposed only in Studio while squad gameplay is a preview.
function Transactions.previewRestart(profile)
	local updated = Transactions.migrate(profile)
	updated.previewFreeRerolls = 1
	return updated, "RESET"
end
function Transactions.previewReroll(profile)
	local updated = Transactions.migrate(profile)
	if updated.previewFreeRerolls > 0 then
		updated.previewFreeRerolls -= 1
		updated.sessionRerolls += 1
		return updated, "SPENT"
	end
	return Transactions.spend(updated, "rerolls")
end
return Transactions
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="15">
      <Properties>
        <string name="Name">ShopServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
local Quests = require(ReplicatedStorage.QuestConfig)
local Transactions = require(script.Parent.Shop.Transactions)
local BestTeam = require(script.Parent.Shop.BestTeam)
local rosterById = {}
for _, offer in ipairs(Catalog.Offers) do rosterById[offer.id] = offer.player end
local preview = RunService:IsStudio()
local store = not preview and DataStoreService:GetDataStore("CollegeHoopsShop_v1") or nil
local profiles, busy, lastRequest, sessions = {}, {}, {}, {}
local remote = Instance.new("RemoteFunction")
remote.Name = "HoopsShop"
local questsById = {}
for _, quest in ipairs(Quests) do questsById[quest.id] = quest end
local function key(player) return "player_" .. player.UserId end
local function elapsed(player)
	local session = sessions[player]
	return session and math.max(0, math.floor(os.clock() - session.started)) or 0
end
local function publish(player)
	local profile = profiles[player]
	if not profile or player.Parent ~= Players then return end
	player:SetAttribute("HoopsCash", profile.balance)
	player:SetAttribute("QuestRerolls", profile.rerolls)
	player:SetAttribute("QuestRefreshes", profile.refreshes)
end
local function response(player, code)
	local profile = profiles[player]
	local session = sessions[player]
	if profile and session then
		profile = Transactions.advanceSession(profile, session.id, elapsed(player))
	end
	return { code = code, ready = profile ~= nil, preview = preview,
		bestTeam = profile and BestTeam.select(profile.owned, rosterById) or nil,
		balance = profile and profile.balance or 0, owned = profile and profile.owned or {},
		playSeconds = profile and profile.playSeconds or 0,
		rerolls = profile and profile.rerolls or 0, refreshes = profile and profile.refreshes or 0,
		claimedQuests = profile and profile.claimedQuests or {},
		sessionClaimed = profile and profile.sessionClaimed or {},
		sessionUnlocks = profile and profile.sessionUnlocks or 0,
		sessionRerolls = profile and profile.sessionRerolls or 0,
		previewFreeRerolls = profile and profile.previewFreeRerolls or 0 }
end
local function load(player)
	local sessionId = HttpService:GenerateGUID(false)
	local profile
	if preview then
		profile = Transactions.startSession(Transactions.newProfile(1000000), sessionId)
	else
		profile = store:UpdateAsync(key(player), function(current)
			return Transactions.startSession(current or Transactions.newProfile(0), sessionId)
		end)
	end
	profiles[player] = profile
	sessions[player] = { id = sessionId, started = os.clock() }
	publish(player)
end
-- Every wallet mutation includes the current online-time checkpoint in the same save.
-- Absolute per-session elapsed time makes retried UpdateAsync callbacks idempotent.
local function commit(player, mutate)
	local session = sessions[player]
	local seconds = elapsed(player)
	local code = "READY"
	local function transform(current)
		if current.clockSession ~= session.id then
			code = "STALE_SESSION"
			return current
		end
		local updated = Transactions.advanceSession(current, session.id, seconds)
		if mutate then updated, code = mutate(updated) end
		return updated
	end
	if preview then
		profiles[player] = transform(profiles[player])
	else
		profiles[player] = store:UpdateAsync(key(player), function(current)
			return transform(current or Transactions.startSession(Transactions.newProfile(0), session.id))
		end)
	end
	publish(player)
	return code
end
local allowed = { State = true, Buy = true, ClaimQuest = true, SpendReroll = true, SpendRefresh = true, PreviewReroll = true, PreviewRestart = true }
remote.OnServerInvoke = function(player, action, id)
	if type(action) ~= "string" or not allowed[action] then return response(player, "INVALID") end
	if busy[player] or os.clock() - (lastRequest[player] or -math.huge) < 0.4 then return response(player, "BUSY") end
	lastRequest[player], busy[player] = os.clock(), true
	local ok, result = pcall(function()
		if not profiles[player] then load(player) end
		if action == "State" then return response(player, "READY") end
		local code
		if action == "Buy" then
			local offer = type(id) == "string" and Catalog.ById[id]
			if not offer then return response(player, "INVALID") end
			code = commit(player, function(profile) return Transactions.purchase(profile, offer) end)
		elseif action == "ClaimQuest" then
			local quest = type(id) == "string" and questsById[id]
			if not quest then return response(player, "INVALID") end
			code = commit(player, function(profile) return Transactions.claim(profile, quest) end)
		elseif action == "PreviewReroll" or action == "PreviewRestart" then
			if not preview then return response(player, "INVALID") end
			code = commit(player, action == "PreviewReroll" and Transactions.previewReroll or Transactions.previewRestart)
		else
			local resource = action == "SpendReroll" and "rerolls" or "refreshes"
			code = commit(player, function(profile) return Transactions.spend(profile, resource) end)
		end
		return response(player, code)
	end)
	busy[player] = nil
	if not ok then
		warn("Hoops profile request failed for user", player.UserId)
		return response(player, "UNAVAILABLE")
	end
	return result
end
remote.Parent = ReplicatedStorage
local function joined(player)
	if busy[player] or profiles[player] then return end
	busy[player] = true
	local ok = pcall(load, player)
	busy[player] = nil
	if not ok then warn("Hoops profile load will retry for user", player.UserId) end
end
Players.PlayerAdded:Connect(joined)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(joined, player) end
-- Save online playtime even when the player never opens a menu.
task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(function()
				if busy[player] then return end
				busy[player] = true
				local ok = pcall(function()
					if not profiles[player] then load(player) else commit(player) end
				end)
				busy[player] = nil
				if not ok then warn("Playtime checkpoint will retry for user", player.UserId) end
			end)
		end
	end
end)
local function flush(player)
	while busy[player] do task.wait(0.05) end
	busy[player] = true
	local ok = true
	if profiles[player] then
		for attempt = 1, 3 do
			ok = pcall(commit, player)
			if ok then break end
			task.wait(attempt)
		end
	end
	busy[player] = nil
	return ok
end
Players.PlayerRemoving:Connect(function(player)
	if not flush(player) then warn("Final playtime checkpoint failed for user", player.UserId) end
	profiles[player], lastRequest[player], sessions[player] = nil, nil, nil
end)
game:BindToClose(function()
	local remaining = 0
	for _, player in ipairs(Players:GetPlayers()) do
		remaining += 1
		task.spawn(function() flush(player); remaining -= 1 end)
	end
	while remaining > 0 do task.wait(0.05) end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="18">
        <Properties>
          <string name="Name">HoopsUI</string>
          <string name="Source"><![CDATA[-- Staged implementation / Feature 1: standalone interface only.
-- Paste into a LocalScript named HoopsUI under StarterPlayerScripts.
-- Studio preview counters are disposable. Real actions require a future server feature.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
if playerGui:FindFirstChild("CollegeHoopsUI") then
	return -- Prevent duplicate copies of this interface.
end
local preview = RunService:IsStudio()
local colors = {
	background = Color3.fromRGB(15, 20, 29),
	panel = Color3.fromRGB(25, 33, 46),
	button = Color3.fromRGB(43, 56, 74),
	accent = Color3.fromRGB(100, 229, 170),
	danger = Color3.fromRGB(242, 135, 135),
	text = Color3.fromRGB(241, 244, 249),
	muted = Color3.fromRGB(168, 181, 199),
}
local function create(className, parent, properties)
	local object = Instance.new(className)
	for key, value in pairs(properties) do
		object[key] = value
	end
	object.Parent = parent
	return object
end
local function round(object)
	create("UICorner", object, { CornerRadius = UDim.new(0, 3) })
end
local gui = create("ScreenGui", playerGui, {
	Name = "CollegeHoopsUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 10,
	ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
})
local background = create("Frame", gui, {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Visible = false,
	BorderSizePixel = 0,
})
background:GetPropertyChangedSignal("Visible"):Connect(function()
	gui:SetAttribute("PanelOpen", background.Visible)
end)
local build = create("TextButton", gui, {
	Name = "Build",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.new(1, -32, 0, 64),
	Text = "Build Your Squad",
	Font = Enum.Font.GothamBold,
	TextSize = 20,
	BackgroundColor3 = Color3.fromRGB(8, 12, 12),
	TextColor3 = colors.text,
	BorderSizePixel = 0,
	Visible = true,
	Selectable = true,
})
round(build)
create("UISizeConstraint", build, { MaxSize = Vector2.new(320, 64) })
create("UIStroke", build, {
	ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	Thickness = 2,
	Color = Color3.fromRGB(83, 220, 133),
})
-- A fixed design canvas scales to the available safe area: no scrolling.
local canvas = create("Frame", background, {
	Name = "SquadCanvas",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(1120, 680),
	BackgroundTransparency = 1,
})
local canvasScale = create("UIScale", canvas, { Scale = 1 })
local function fitCanvas()
	local size = background.AbsoluteSize
	canvasScale.Scale = math.min(size.X / 1120, size.Y / 680)
end
local resizeConnection = background:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitCanvas)
fitCanvas()
local function textAt(parent, name, text, x, y, width, height, size, color)
	return create("TextLabel", parent, {
		Name = name,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color or colors.text,
		Font = Enum.Font.GothamBold,
		TextWrapped = true,
		TextStrokeTransparency = 0.5,
	})
end
local function outline(object, color)
	create("UIStroke", object, {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Thickness = 2,
		Color = color or colors.accent,
	})
end
textAt(canvas, "Title", "BUILD YOUR\nSQUAD", 24, 18, 280, 100, 38)
textAt(canvas, "Mode", preview and "STUDIO UI PREVIEW" or "UI ONLY", 24, 120, 280, 24, 14, colors.accent)
local counters = textAt(canvas, "Counters", "", 24, 147, 280, 40, 15)
local actions = create("Frame", canvas, {
	Name = "Actions",
	Position = UDim2.fromOffset(44, 202),
	Size = UDim2.fromOffset(240, 422),
	BackgroundTransparency = 1,
})
create("UIListLayout", actions, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
local buttons = {}
local actionNames = { "Roll", "Reroll", "Refresh", "Restart", "Exit" }
for index, name in ipairs(actionNames) do
	local button = create("TextButton", actions, {
		Name = name:gsub(" ", ""),
		LayoutOrder = index,
		Size = UDim2.fromOffset(240, 50),
		Text = name:upper(),
		BackgroundColor3 = Color3.fromRGB(8, 12, 12),
		BackgroundTransparency = 0.12,
		TextColor3 = colors.text,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Selectable = true,
	})
	round(button)
	outline(button, (name == "Restart" or name == "Exit") and colors.danger or colors.accent)
	buttons[name] = button
end
textAt(canvas, "Overall", "TEAM OVR: —   |   CHEMISTRY: —", 340, 16, 748, 40, 26)
textAt(canvas, "SchoolSeason", "School & season: awaiting game system", 340, 61, 748, 28, 16)
local court = create("Frame", canvas, {
	Name = "CurrentPlayers",
	Position = UDim2.fromOffset(340, 100),
	Size = UDim2.fromOffset(748, 366),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
})
outline(court)
local lineup = textAt(court, "LineupCount", "", 12, 6, 724, 26, 17)
local positions = { "PG", "SG", "SF", "PF", "C" }
local slotLocations =
	{ Vector2.new(184, 44), Vector2.new(414, 44), Vector2.new(70, 204), Vector2.new(299, 204), Vector2.new(528, 204) }
local slots = {}
for index, position in ipairs(positions) do
	local point = slotLocations[index]
	local card = textAt(court, position, position .. "\n\nEMPTY", point.X, point.Y, 150, 140, 21)
	card.BackgroundColor3 = colors.panel
	card.BackgroundTransparency = 0.24
	card.BorderSizePixel = 0
	round(card)
	outline(card, colors.muted)
	slots[index] = card
end
textAt(canvas, "CandidatesTitle", "CHOOSE A PLAYER  |  ONE PER POSITION", 340, 477, 748, 24, 16)
local candidateButtons = {}
for index, position in ipairs(positions) do
	local card = create("TextButton", canvas, {
		Name = "Candidate" .. position,
		Position = UDim2.fromOffset(340 + (index - 1) * 152, 509),
		Size = UDim2.fromOffset(140, 100),
		Text = position,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextWrapped = true,
		TextColor3 = colors.text,
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.16,
		BorderSizePixel = 0,
		Selectable = true,
		AutoButtonColor = true,
	})
	round(card)
	outline(card, colors.muted)
	candidateButtons[index] = card
end
local reveal = textAt(canvas, "SelectedPlayer", "Select a candidate", 24, 522, 280, 74, 16)
local status = textAt(
	canvas,
	"Status",
	"Choose a candidate to fill their position. Preview players only; nothing is saved.",
	340,
	622,
	748,
	46,
	16
)
status.BackgroundColor3 = colors.panel
status.BackgroundTransparency = 0.15
status.BorderSizePixel = 0

local overlay = create("TextButton", gui, {
	Name = "ConfirmationOverlay",
	Size = UDim2.fromScale(1, 1),
	Text = "",
	BackgroundColor3 = Color3.new(),
	BackgroundTransparency = 0.25,
	AutoButtonColor = false,
	Selectable = false,
	Visible = false,
	ZIndex = 20,
	Modal = true,
})
local dialog = create("Frame", overlay, {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(1, -32, 0, 224),
	BackgroundColor3 = colors.panel,
	BorderSizePixel = 0,
	ZIndex = 21,
})
round(dialog)
create("UISizeConstraint", dialog, { MaxSize = Vector2.new(460, 224) })
local dialogText = create("TextLabel", dialog, {
	Position = UDim2.fromOffset(16, 16),
	Size = UDim2.new(1, -32, 0, 124),
	BackgroundTransparency = 1,
	TextColor3 = colors.text,
	TextSize = 18,
	Font = Enum.Font.GothamMedium,
	TextWrapped = true,
	ZIndex = 22,
	Text = "RESTART PREVIEW?\n\nClears this UI preview and sets Rerolls and Refreshes to 1 each. No real team or collection exists yet.",
})
local function dialogButton(text, x)
	local button = create("TextButton", dialog, {
		Position = UDim2.new(x, 12, 1, -68),
		Size = UDim2.new(0.5, -24, 0, 52),
		Text = text,
		TextColor3 = colors.text,
		BackgroundColor3 = colors.button,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		BorderSizePixel = 0,
		ZIndex = 22,
		Selectable = true,
	})
	round(button)
	return button
end
local cancel = dialogButton("CANCEL", 0)
local confirm = dialogButton("RESTART", 0.5)
local freeRerolls, freeRefreshes = 1, 1
local spendingReward = false
local bonusRerolls = Players.LocalPlayer:GetAttribute("QuestRerolls") or 0
local bonusRefreshes = Players.LocalPlayer:GetAttribute("QuestRefreshes") or 0
local finished = false
local pendingAction, returnFocus, selected = nil, nil, nil
local squad, candidates = {}, {}
-- Disposable UI fixtures, not the real roster, ratings, or drop odds.
local rng = Random.new()
local previewSequence = 0
local function newPreviewPlayer(position)
	previewSequence += 1
	return { name = position .. " Prospect " .. rng:NextInteger(100, 999), id = previewSequence }
end
local function refillCandidates()
	for index, position in ipairs(positions) do
		candidates[index] = newPreviewPlayer(position)
	end
end
local function countFilled()
	local count = 0
	for index = 1, 5 do
		if squad[index] then
			count += 1
		end
	end
	return count
end
local function setModal(open)
	overlay.Visible = open
	for _, button in pairs(buttons) do
		button.Selectable = not open
		button.Active = not open
	end
	for _, button in ipairs(candidateButtons) do
		button.Selectable = not open
		button.Active = not open
	end
end
local function render()
	local filled = countFilled()
	counters.Text = preview and string.format("Rerolls: %d free + %d quest\nRefreshes: %d free + %d quest", freeRerolls, bonusRerolls, freeRefreshes, bonusRefreshes)
		or "Free actions: awaiting server"
	buttons.Reroll.Text = filled == 5 and (finished and "FINISHED" or "FINISH")
		or (preview and string.format("REROLL  |  %d LEFT", freeRerolls + bonusRerolls) or "REROLL")
	buttons.Refresh.Text = preview and string.format("REFRESH  |  %d LEFT", freeRefreshes + bonusRefreshes) or "REFRESH"
	lineup.Text = string.format("CURRENT PLAYERS  |  %d / 5 preview slots", filled)
	for index, slot in ipairs(slots) do
		local player = squad[index]
		slot.Text = positions[index] .. "\n\n" .. (player and player.name or "EMPTY")
		slot.TextColor3 = player and colors.accent or colors.text
		local card = candidateButtons[index]
		card.Text = positions[index]
			.. "\n"
			.. (preview and candidates[index].name or "Awaiting roster")
			.. (selected == index and "\nSELECTED" or "")
		card.BackgroundColor3 = selected == index and colors.button or colors.panel
	end
	reveal.Text = selected and ("SELECTED: " .. positions[selected] .. "\n" .. squad[selected].name)
		or "Select a candidate"
end
local function closeDialog()
	setModal(false)
	pendingAction = nil
	GuiService.SelectedObject = returnFocus
end
local function openDialog(action, text)
	pendingAction = action
	returnFocus = GuiService.SelectedObject
	dialogText.Text = text
	confirm.Text = action == "Restart" and "RESTART" or "FINISH PREVIEW"
	setModal(true)
	GuiService.SelectedObject = cancel
end
cancel.NextSelectionLeft = confirm
cancel.NextSelectionRight = confirm
cancel.NextSelectionUp = confirm
cancel.NextSelectionDown = confirm
confirm.NextSelectionLeft = cancel
confirm.NextSelectionRight = cancel
confirm.NextSelectionUp = cancel
confirm.NextSelectionDown = cancel
local function spendQuestReward(action)
	spendingReward = true
	status.Text = "Using quest reward…"
	local ok, result = pcall(function()
		local remote = game:GetService("ReplicatedStorage"):WaitForChild("HoopsShop", 10)
		if not remote then error("Reward server unavailable") end
		return remote:InvokeServer(action)
	end)
	spendingReward = false
	if ok and (result.code == "SPENT" or result.code == "RESET") then
		bonusRerolls, bonusRefreshes = result.rerolls, result.refreshes
		freeRerolls = result.previewFreeRerolls
		return true
	end
	status.Text = ok and result.code == "EMPTY" and "No quest rewards left. Play longer and claim a milestone."
		or "Could not use a quest reward. Please try again shortly."
	render()
	return false
end
local function restartPreview()
	if not spendQuestReward("PreviewRestart") then return end
	freeRerolls, freeRefreshes = 1, 1
	squad, selected, finished = {}, nil, false
	refillCandidates()
	status.Text = "Preview restarted. Choose a player for each position. Free counters reset to 1."
	render()
end
local function canEdit()
	if spendingReward or overlay.Visible or not background.Visible then
		return false
	end
	if not preview then
		status.Text = "UI ready. Real roster actions need the later server stage."
		return false
	end
	if finished then
		status.Text = "Preview finished. Restart to test another squad."
		return false
	end
	return true
end
local function chooseCandidate(index)
	if not canEdit() then
		return
	end
	selected = index
	-- Candidate selection immediately accepts that preview player into its position.
	squad[index] = candidates[index]
	status.Text = countFilled() == 5 and "All five players chosen. Press Finish to end this preview."
		or (positions[index] .. " filled. Choose another position, or Reroll this player.")
	render()
end
for index, button in ipairs(candidateButtons) do
	button.Activated:Connect(function()
		chooseCandidate(index)
	end)
end
cancel.Activated:Connect(closeDialog)
confirm.Activated:Connect(function()
	if not overlay.Visible then
		return
	end
	local action = pendingAction
	closeDialog()
	if action == "Restart" then
		restartPreview()
	elseif action == "Finish" and countFilled() == 5 and not finished then
		finished = true
		status.Text = "Preview finished. No cards or team were saved. Restart to test again."
		render()
	end
end)
for name, button in pairs(buttons) do
	button.Activated:Connect(function()
		if spendingReward or overlay.Visible or not background.Visible then
			return
		end
		if name == "Exit" then
			background.Visible = false
			build.Visible = true
			GuiService.SelectedObject = build
			return
		end
		if name == "Restart" and preview then
			if countFilled() > 0 and not finished then
				openDialog(
					"Restart",
					"RESTART PREVIEW?\n\nDiscard all five-position preview progress and candidates. Both free counters reset to 1. No permanent collection is affected."
				)
			else
				restartPreview()
			end
			return
		end
		if not canEdit() then
			return
		end
		if name == "Roll" then
			for index = 1, 5 do
				if not squad[index] then
					chooseCandidate(index)
					return
				end
			end
			status.Text = "All positions are filled. Press Finish."
		elseif name == "Reroll" then
			-- Finish takes priority over spending the Reroll resource.
			if countFilled() == 5 then
				openDialog(
					"Finish",
					"FINISH PREVIEW?\n\nAll five positions are filled. End this UI test? Nothing is saved in this stage."
				)
				return
			end
			if not selected then
				status.Text = "Choose a candidate first so Reroll knows which player to replace."
				return
			end
			if not spendQuestReward("PreviewReroll") then return end
			candidates[selected] = newPreviewPlayer(positions[selected])
			squad[selected] = candidates[selected]
			status.Text = "Selected player replaced and automatically placed in the squad."
			render()
		elseif name == "Refresh" then
			if freeRefreshes > 0 then
				freeRefreshes -= 1
			elseif not spendQuestReward("SpendRefresh") then
				return
			end
			refillCandidates()
			status.Text = "Five preview candidates refreshed, one per position. Current squad preserved."
			render()
		end
	end)
end
refillCandidates()
Players.LocalPlayer:GetAttributeChangedSignal("QuestRerolls"):Connect(function()
	bonusRerolls = Players.LocalPlayer:GetAttribute("QuestRerolls") or 0
	render()
end)
Players.LocalPlayer:GetAttributeChangedSignal("QuestRefreshes"):Connect(function()
	bonusRefreshes = Players.LocalPlayer:GetAttribute("QuestRefreshes") or 0
	render()
end)
build.Activated:Connect(function()
	build.Visible = false
	background.Visible = true
	GuiService.SelectedObject = buttons.Roll
end)
local inputConnection = UserInputService.InputBegan:Connect(function(input)
	if overlay.Visible and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
		closeDialog()
	end
end)
gui.Destroying:Connect(function()
	inputConnection:Disconnect()
	resizeConnection:Disconnect()
end)
render()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">BestTeamUI</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
if playerGui:FindFirstChild("HoopsBestTeamUI") then return end
local blue = Color3.fromRGB(104, 192, 255)
local white = Color3.fromRGB(246, 247, 250)
local muted = Color3.fromRGB(170, 182, 201)
local dark = Color3.fromRGB(9, 14, 22)
local function make(kind, parent, props)
	local object = Instance.new(kind)
	for key, value in pairs(props) do object[key] = value end
	object.Parent = parent
	return object
end
local function outline(object, color)
	make("UIStroke", object, { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = color, Thickness = 2 })
end
local function label(parent, name, value, x, y, w, h, size, color)
	return make("TextLabel", parent, { Name = name, Text = value, Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, TextColor3 = color or white,
		Font = Enum.Font.GothamBold, TextSize = size, TextWrapped = true, BorderSizePixel = 0 })
end
local function button(parent, name, value, position, size)
	local object = make("TextButton", parent, { Name = name, Text = value, Position = position,
		Size = size, BackgroundColor3 = dark, TextColor3 = white, Font = Enum.Font.GothamBold,
		TextSize = 16, BorderSizePixel = 0, Selectable = true })
	outline(object, blue)
	return object
end
local gui = make("ScreenGui", playerGui, { Name = "HoopsBestTeamUI", ResetOnSpawn = false,
	DisplayOrder = 16, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets })
local entry = button(gui, "BestTeam", "BEST TEAM", UDim2.new(0, 24, 1, -112), UDim2.fromOffset(184, 52))
local page = make("Frame", gui, { Name = "BestTeamPage", Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = dark, BackgroundTransparency = 0.04, BorderSizePixel = 0, Visible = false, Active = true })
local canvas = make("Frame", page, { Name = "LineupCanvas", AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(900, 680), BackgroundTransparency = 1 })
local scale = make("UIScale", canvas, { Scale = 1 })
local function fit()
	scale.Scale = math.min(page.AbsoluteSize.X / 924, page.AbsoluteSize.Y / 704, 1.2)
end
page:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
fit()
label(canvas, "Title", "BEST TEAM", 24, 8, 360, 48, 32, blue).TextXAlignment = Enum.TextXAlignment.Left
local close = button(canvas, "Close", "X", UDim2.fromOffset(826, 12), UDim2.fromOffset(48, 44))
local status = label(canvas, "Status", "", 30, 624, 840, 44, 17, muted)
local points = { Vector2.new(450, 166), Vector2.new(725, 312), Vector2.new(620, 534),
	Vector2.new(280, 534), Vector2.new(175, 312) }
-- Connect all five card centers to make the lineup's pentagon explicit.
for index, point in ipairs(points) do
	local nextPoint = points[index % 5 + 1]
	local delta, middle = nextPoint - point, (nextPoint + point) / 2
	make("Frame", canvas, { Name = "PentagonEdge" .. index, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(middle.X, middle.Y), Size = UDim2.fromOffset(delta.Magnitude, 2),
		Rotation = math.deg(math.atan2(delta.Y, delta.X)), BackgroundColor3 = blue,
		BackgroundTransparency = 0.65, BorderSizePixel = 0 })
end
local overall = label(canvas, "TeamOverall", "—", 340, 300, 220, 72, 58, blue)
label(canvas, "OverallCaption", "TEAM OVR", 340, 373, 220, 28, 18, muted)
local count = label(canvas, "PlayerCount", "0 / 5 PLAYERS", 330, 405, 240, 26, 15, muted)
local slots = {}
for index, point in ipairs(points) do
	local card = make("Frame", canvas, { Name = "Player" .. index, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(point.X, point.Y), Size = UDim2.fromOffset(186, 160),
		BackgroundColor3 = Color3.fromRGB(22, 30, 44), BorderSizePixel = 0 })
	outline(card, blue)
	local rating = label(card, "Overall", "—", 8, 6, 84, 40, 30, blue)
	local position = label(card, "Position", "", 116, 12, 60, 28, 19, blue)
	local name = label(card, "PlayerName", "EMPTY SLOT", 10, 53, 166, 61, 21)
	local rarity = label(card, "Rarity", "Unlock a player", 8, 123, 170, 25, 13, muted)
	slots[index] = { rating = rating, position = position, name = name, rarity = rarity }
end
local function render(team)
	local players = team and team.players or {}
	overall.Text = #players > 0 and tostring(team.overall) or "—"
	count.Text = string.format("%d / 5 PLAYERS", #players)
	for index, slot in ipairs(slots) do
		local card = players[index]
		slot.rating.Text = card and tostring(card.overall) or "—"
		slot.position.Text = card and card.position or ""
		slot.name.Text = card and card.name or "EMPTY SLOT"
		slot.rarity.Text = card and card.rarity or "Unlock a player"
	end
end
local mainGui, mainWasEnabled
local generation = 0
local function visibility()
	local main = playerGui:FindFirstChild("CollegeHoopsUI")
	entry.Visible = not playerGui:GetAttribute("HoopsPanel") and not (main and main:GetAttribute("PanelOpen"))
end
local function closePage()
	if not page.Visible then return end
	generation += 1
	page.Visible = false
	if mainGui and mainGui.Parent then mainGui.Enabled = mainWasEnabled end
	playerGui:SetAttribute("HoopsPanel", nil)
	visibility()
	GuiService.SelectedObject = entry
end
entry.Activated:Connect(function()
	if playerGui:GetAttribute("HoopsPanel") then return end
	generation += 1
	local requestId = generation
	mainGui = playerGui:FindFirstChild("CollegeHoopsUI")
	if mainGui then mainWasEnabled = mainGui.Enabled; mainGui.Enabled = false end
	playerGui:SetAttribute("HoopsPanel", "BestTeam")
	page.Visible = true
	GuiService.SelectedObject = close
	render(nil)
	status.Text = "Loading your best five…"
	task.spawn(function()
		local ok, result = pcall(function()
			local remote = ReplicatedStorage:WaitForChild("HoopsShop", 10)
			if not remote then error("Roster unavailable") end
			local response
			for _ = 1, 3 do
				response = remote:InvokeServer("State")
				if response.code ~= "BUSY" then break end
				task.wait(0.5)
			end
			return response
		end)
		if generation ~= requestId then return end
		if not ok or type(result) ~= "table" or not result.ready or not result.bestTeam then
			status.Text = "Could not load your roster. Close and reopen Best Team to retry."
			return
		end
		render(result.bestTeam)
		local n = #result.bestTeam.players
		status.Text = n == 0 and "Unlock players in the Shop to build your best team."
			or (n < 5 and "Own more players to fill all five slots. OVR averages your available players."
			or "Your five highest-rated players · Team OVR is their rounded average.")
	end)
end)
close.Activated:Connect(closePage)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then closePage() end
end)
playerGui:GetAttributeChangedSignal("HoopsPanel"):Connect(visibility)
local function bindMain(object)
	if object.Name == "CollegeHoopsUI" then
		object:GetAttributeChangedSignal("PanelOpen"):Connect(visibility)
		visibility()
	end
end
playerGui.ChildAdded:Connect(bindMain)
for _, object in ipairs(playerGui:GetChildren()) do bindMain(object) end
visibility()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">QuestsUI</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
if playerGui:FindFirstChild("HoopsQuestsUI") then return end
local Quests = require(ReplicatedStorage:WaitForChild("QuestConfig"))
local red = Color3.fromRGB(247, 111, 124)
local green = Color3.fromRGB(100, 239, 170)
local gold = Color3.fromRGB(255, 207, 89)
local muted = Color3.fromRGB(170, 182, 201)
local dark = Color3.fromRGB(9, 14, 22)
local function make(kind, parent, props)
	local object = Instance.new(kind)
	for key, value in pairs(props) do object[key] = value end
	object.Parent = parent
	return object
end
local function text(parent, value, pos, size, fontSize, color)
	return make("TextLabel", parent, { Text = value, Position = pos, Size = size,
		BackgroundTransparency = 1, TextColor3 = color or muted, Font = Enum.Font.GothamBold,
		TextSize = fontSize, TextWrapped = true })
end
local function outline(object, color)
	make("UIStroke", object, { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = color, Thickness = 2 })
end
local function button(parent, name, value, pos, size, color)
	local object = make("TextButton", parent, { Name = name, Text = value, Position = pos, Size = size,
		BackgroundColor3 = dark, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold,
		TextSize = 16, BorderSizePixel = 0, Selectable = true })
	outline(object, color)
	return object
end
local function duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60)
end
local function cash(amount)
	return "$" .. tostring(amount):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end
local gui = make("ScreenGui", playerGui, { Name = "HoopsQuestsUI", ResetOnSpawn = false,
	DisplayOrder = 16, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets })
local entry = button(gui, "Quests", "QUESTS", UDim2.new(1, -208, 1, -114), UDim2.fromOffset(184, 52), red)
local page = make("Frame", gui, { Name = "QuestsPage", Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = dark, BackgroundTransparency = 0.06, Visible = false, Active = true, BorderSizePixel = 0 })
text(page, "QUESTS", UDim2.fromOffset(18, 14), UDim2.new(1, -100, 0, 40), 25, red)
local close = button(page, "Close", "X", UDim2.new(1, -62, 0, 12), UDim2.fromOffset(44, 44), muted)
local timer = text(page, "Loading playtime…", UDim2.fromOffset(18, 61), UDim2.new(1, -36, 0, 27), 18, gold)
text(page, "Playtime: permanent milestones. Unlocks & rerolls: reset each login.", UDim2.fromOffset(18, 91), UDim2.new(1, -36, 0, 38), 13)
local balances = text(page, "", UDim2.fromOffset(18, 133), UDim2.new(1, -36, 0, 30), 14, green)
local scroll = make("ScrollingFrame", page, { Name = "Milestones", Position = UDim2.fromOffset(18, 176),
	Size = UDim2.new(1, -36, 1, -258), BackgroundTransparency = 1, BorderSizePixel = 0,
	AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 5,
	ScrollBarImageColor3 = red, ScrollingDirection = Enum.ScrollingDirection.Y })
make("UIPadding", scroll, { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) })
make("UIListLayout", scroll, { Padding = UDim.new(0, 16), SortOrder = Enum.SortOrder.LayoutOrder })
local status = text(page, "Play to earn cash, rerolls, and refreshes.", UDim2.new(0, 18, 1, -70), UDim2.new(1, -36, 0, 58), 14)
local state = { ready = false, playSeconds = 0, claimedQuests = {}, rerolls = 0, refreshes = 0 }
local receivedAt, pending = os.clock(), false
local cards = {}
local request
local function render()
	local seconds = state.playSeconds + (state.ready and os.clock() - receivedAt or 0)
	timer.Text = state.ready and ("TIME PLAYED  " .. duration(seconds)) or "Loading playtime…"
	balances.Text = string.format("Quest rewards left: %d rerolls  ·  %d refreshes", state.rerolls, state.refreshes)
	for _, item in ipairs(cards) do
		local quest = item.quest
		local sessionQuest = quest.scope == "SESSION"
		local claimedFlags = sessionQuest and (state.sessionClaimed or {}) or state.claimedQuests
		local claimed = claimedFlags[quest.id] == true
		local progress = sessionQuest and (state[quest.metric] or 0) or seconds
		local target = sessionQuest and quest.target or quest.seconds
		local ready = state.ready and progress >= target
		item.fill.Size = UDim2.fromScale(math.clamp(progress / target, 0, 1), 1)
		local remaining = sessionQuest and string.format("%d / %d this login", math.min(progress, target), target)
			or (duration(target - progress) .. " remaining")
		item.progress.Text = claimed and "Reward collected" or (ready and "Ready to claim!" or remaining)
		item.claim.Text = claimed and "CLAIMED" or (ready and "CLAIM" or "LOCKED")
		item.claim.TextColor3 = (ready or claimed) and green or muted
		item.claim.Active = ready and not claimed and not pending
		item.claim.Selectable = item.claim.Active
		item.claim.AutoButtonColor = item.claim.Active
	end
end
for index, quest in ipairs(Quests) do
	local card = make("Frame", scroll, { Name = quest.id, LayoutOrder = index, Size = UDim2.new(1, 0, 0, 182),
		BackgroundColor3 = Color3.fromRGB(22, 30, 44), BorderSizePixel = 0 })
	outline(card, red)
	text(card, (quest.title or string.format("PLAY %d %s", quest.hours or 0, quest.hours == 1 and "HOUR" or "HOURS")), UDim2.fromOffset(12, 8), UDim2.new(1, -24, 0, 30), 21, Color3.new(1, 1, 1))
	local rewards = quest.scope == "SESSION"
		and { cash(quest.cash) .. "\nCASH", "RESETS EACH\nLOGIN", "CLAIM ONCE\nPER LOGIN" }
		or { cash(quest.cash) .. "\nCASH", quest.rerolls .. "\nREROLLS", quest.refreshes .. "\nREFRESHES" }
	for col, reward in ipairs(rewards) do
		text(card, reward, UDim2.new((col - 1) / 3, 4, 0, 46), UDim2.new(1 / 3, -8, 0, 48), 16, col == 1 and gold or green)
	end
	local track = make("Frame", card, { Position = UDim2.new(0, 12, 0, 104), Size = UDim2.new(1, -24, 0, 8),
		BackgroundColor3 = Color3.fromRGB(47, 58, 74), BorderSizePixel = 0, ClipsDescendants = true })
	local fill = make("Frame", track, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = green, BorderSizePixel = 0 })
	local progress = text(card, "", UDim2.fromOffset(12, 124), UDim2.new(1, -136, 0, 42), 13)
	local claim = button(card, "Claim", "LOCKED", UDim2.new(1, -116, 0, 126), UDim2.fromOffset(104, 38), green)
	table.insert(cards, { quest = quest, fill = fill, progress = progress, claim = claim })
	claim.Activated:Connect(function()
		if not claim.Active or pending then return end
		request("ClaimQuest", quest.id)
	end)
end
request = function(action, id)
	if pending then return end
	pending = true
	if action == "ClaimQuest" then status.Text = "Claiming rewards…" end
	render()
	local ok, result = pcall(function()
		local remote = ReplicatedStorage:WaitForChild("HoopsShop", 10)
		if not remote then error("Profile server unavailable") end
		return remote:InvokeServer(action, id)
	end)
	pending = false
	if ok and type(result) == "table" then
		state, receivedAt = result, os.clock()
		local messages = {
			READY = result.preview and "Studio trial: real-time timer; progress resets when Play stops." or "Playtime saves across visits. Activity quests start fresh each login.",
			REWARDED = "Reward claimed and added to your balance!",
			CLAIMED = "You already collected this reward.", NOT_READY = "Keep playing! This milestone is not ready yet.",
			STALE_SESSION = "A newer login is active. Rejoin to continue here.",
			BUSY = "Please wait a moment, then try again.", INVALID = "This quest is unavailable.",
			UNAVAILABLE = "Could not save rewards. Refreshing will check whether your claim was saved.",
		}
		if action ~= "State" or status.Text == "Loading…" or not result.ready then
			status.Text = messages[result.code] or "Please reopen Quests to refresh."
		end
	else
		state.ready = false
		status.Text = "Could not reach the server. Your progress will refresh shortly."
	end
	render()
end
-- Stack lobby controls on narrow screens so they do not cover Build or Shop.
local function fitLobby()
	entry.Position = UDim2.new(1, -208, 1, page.AbsoluteSize.X < 760 and -286 or -114)
end
page:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitLobby)
fitLobby()
local mainGui, wasEnabled
local function visibility()
	local main = playerGui:FindFirstChild("CollegeHoopsUI")
	entry.Visible = not playerGui:GetAttribute("HoopsPanel") and not (main and main:GetAttribute("PanelOpen"))
end
local function bindMain(object)
	if object.Name == "CollegeHoopsUI" then object:GetAttributeChangedSignal("PanelOpen"):Connect(visibility) end
end
playerGui.ChildAdded:Connect(bindMain)
for _, object in ipairs(playerGui:GetChildren()) do bindMain(object) end
playerGui:GetAttributeChangedSignal("HoopsPanel"):Connect(visibility)
entry.Activated:Connect(function()
	mainGui = playerGui:FindFirstChild("CollegeHoopsUI")
	if mainGui then wasEnabled = mainGui.Enabled; mainGui.Enabled = false end
	page.Visible = true
	playerGui:SetAttribute("HoopsPanel", "Quests")
	status.Text = "Loading…"
	GuiService.SelectedObject = close
	task.spawn(request, "State")
end)
local function closePage()
	page.Visible = false
	if mainGui and mainGui.Parent then mainGui.Enabled = wasEnabled end
	playerGui:SetAttribute("HoopsPanel", nil)
	GuiService.SelectedObject = entry
end
close.Activated:Connect(closePage)
local input = UserInputService.InputBegan:Connect(function(key, processed)
	if not processed and page.Visible and (key.KeyCode == Enum.KeyCode.Escape or key.KeyCode == Enum.KeyCode.ButtonB) then closePage() end
end)
gui.Destroying:Connect(function() input:Disconnect() end)
visibility()
render()
task.spawn(function()
	local ticks = 0
	while gui.Parent do
		task.wait(1)
		if page.Visible then
			render()
			ticks += 1
			if ticks % 15 == 0 or not state.ready then task.spawn(request, "State") end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="21">
        <Properties>
          <string name="Name">ShopUI</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
if playerGui:FindFirstChild("HoopsShopUI") then return end
local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ShopCatalog"))
local gold = Color3.fromRGB(255, 207, 89)
local blue = Color3.fromRGB(104, 192, 255)
local green = Color3.fromRGB(100, 239, 170)
local white = Color3.fromRGB(246, 247, 250)
local muted = Color3.fromRGB(170, 182, 201)
local dark = Color3.fromRGB(9, 14, 22)
local function make(kind, parent, props)
	local object = Instance.new(kind)
	for k, v in pairs(props) do object[k] = v end
	object.Parent = parent
	return object
end
local function stroke(object, color)
	return make("UIStroke", object, { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = color, Thickness = 2 })
end
local function label(parent, name, text, pos, size, fontSize, color)
	return make("TextLabel", parent, { Name = name, Text = text, Position = pos, Size = size,
		BackgroundTransparency = 1, TextColor3 = color or white, Font = Enum.Font.GothamBold,
		TextSize = fontSize, TextWrapped = true, BorderSizePixel = 0 })
end
local function button(parent, name, text, pos, size, color)
	local object = make("TextButton", parent, { Name = name, Text = text, Position = pos, Size = size,
		BackgroundColor3 = dark, TextColor3 = white, Font = Enum.Font.GothamBold,
		TextSize = 16, BorderSizePixel = 0, Selectable = true })
	stroke(object, color)
	return object
end
local function money(value)
	local formatted = tostring(math.floor(value)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return "$" .. formatted
end
local gui = make("ScreenGui", playerGui, { Name = "HoopsShopUI", ResetOnSpawn = false,
	DisplayOrder = 15, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets })
local entry = button(gui, "Shop", "SHOP", UDim2.new(0, 24, 1, -174), UDim2.fromOffset(184, 52), gold)
local lobbyMoney = label(gui, "Cash", "—", UDim2.new(0, 24, 1, -218), UDim2.fromOffset(184, 36), 27, gold)
local page = make("Frame", gui, { Name = "ShopPage", Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = dark, BackgroundTransparency = 0.06, Visible = false, BorderSizePixel = 0, Active = true })
label(page, "Title", "SHOP", UDim2.fromOffset(18, 12), UDim2.fromOffset(115, 44), 30, gold)
local wallet = label(page, "Wallet", "—", UDim2.new(1, -226, 0, 12), UDim2.fromOffset(150, 44), 21, gold)
local close = button(page, "Close", "X", UDim2.new(1, -62, 0, 12), UDim2.fromOffset(44, 44), muted)
local hofTab = button(page, "HOF", "HOF  ·  8", UDim2.fromOffset(18, 70), UDim2.new(0.5, -27, 0, 42), gold)
local nonTab = button(page, "NonCollege", "NON-COLLEGE  ·  4", UDim2.new(0.5, 9, 0, 70), UDim2.new(0.5, -27, 0, 42), blue)
local subtitle = label(page, "Subtitle", "", UDim2.fromOffset(18, 120), UDim2.new(1, -36, 0, 38), 14, muted)
local scroll = make("ScrollingFrame", page, { Name = "PlayerCards", Position = UDim2.fromOffset(18, 168),
	Size = UDim2.new(1, -36, 1, -246), BackgroundTransparency = 1, BorderSizePixel = 0,
	AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 5,
	ScrollBarImageColor3 = gold, ScrollingDirection = Enum.ScrollingDirection.Y })
make("UIPadding", scroll, { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8),
	PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12) })
local grid = make("UIGridLayout", scroll, { CellPadding = UDim2.fromOffset(16, 16),
	CellSize = UDim2.fromOffset(260, 408), SortOrder = Enum.SortOrder.LayoutOrder })
local status = label(page, "Status", "Loading wallet…", UDim2.new(0, 18, 1, -68), UDim2.new(1, -36, 0, 56), 15, muted)
local state = { ready = false, balance = 0, owned = {}, preview = false }
local selectedGroup, pending = "HOF", false
local cards = {}
local request
local function render()
	wallet.Text = money(state.balance)
	lobbyMoney.Text = state.ready and money(state.balance) or "—"
	subtitle.Text = selectedGroup == "HOF" and "College legends · permanent card unlocks" or "No college season · premium player unlocks"
	hofTab.TextColor3 = selectedGroup == "HOF" and gold or muted
	nonTab.TextColor3 = selectedGroup == "NON-COLLEGE" and blue or muted
	for _, item in ipairs(cards) do
		local offer, buy = item.offer, item.buy
		item.frame.Visible = offer.group == selectedGroup
		local owned = state.owned[offer.id] == true
		local enough = state.balance >= offer.price
		buy.Text = owned and "OWNED" or ("BUY  ·  " .. money(offer.price))
		buy.TextColor3 = owned and green or (enough and gold or muted)
		buy.Active = state.ready and not pending and not owned and enough
		buy.Selectable = buy.Active
		buy.AutoButtonColor = buy.Active
		item.lock.Text = owned and "UNLOCKED" or "LOCKED"
		item.lock.TextColor3 = owned and green or muted
	end
end
local attributes = { { "shooting", "SHOOTING" }, { "dribbling", "DRIBBLING" },
	{ "defense", "DEFENSE" }, { "speed", "SPEED" }, { "stamina", "STAMINA" } }
for index, offer in ipairs(Catalog.Offers) do
	local player = offer.player
	local accent = offer.group == "HOF" and gold or blue
	local frame = make("Frame", scroll, { Name = offer.id, LayoutOrder = index,
		BackgroundColor3 = Color3.fromRGB(22, 30, 44), BorderSizePixel = 0 })
	stroke(frame, accent)
	label(frame, "Overall", tostring(player.overall), UDim2.fromOffset(12, 8), UDim2.fromOffset(65, 36), 32, accent)
	label(frame, "OVR", "OVR", UDim2.fromOffset(12, 43), UDim2.fromOffset(65, 18), 12, muted)
	label(frame, "Position", player.position, UDim2.new(1, -70, 0, 12), UDim2.fromOffset(58, 28), 22, accent)
	-- Original jersey icon, no external image dependency. Replace with licensed art later.
	local icon = make("Frame", frame, { Name = "PlayerIcon", AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 19), Size = UDim2.fromOffset(72, 86), BackgroundTransparency = 1 })
	local head = make("Frame", icon, { Position = UDim2.fromOffset(24, 0), Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Color3.fromRGB(207, 213, 224), BorderSizePixel = 0 })
	make("UICorner", head, { CornerRadius = UDim.new(1, 0) })
	for _, x in ipairs({ 0, 56 }) do
		make("Frame", icon, { Position = UDim2.fromOffset(x, 30), Size = UDim2.fromOffset(16, 25),
			BackgroundColor3 = offer.color, BorderSizePixel = 0, Rotation = x == 0 and 20 or -20 })
	end
	local jersey = make("Frame", icon, { Position = UDim2.fromOffset(13, 27), Size = UDim2.fromOffset(46, 57),
		BackgroundColor3 = offer.color, BorderSizePixel = 0 })
	label(jersey, "Number", offer.number, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 25)
	label(frame, "PlayerName", player.name, UDim2.fromOffset(8, 111), UDim2.new(1, -16, 0, 43), 20)
	label(frame, "SchoolSeason", player.school and (player.school .. " · " .. player.season) or "NON-COLLEGE EXCLUSIVE",
		UDim2.fromOffset(8, 157), UDim2.new(1, -16, 0, 26), 12, accent)
	for row, attribute in ipairs(attributes) do
		local y = 194 + (row - 1) * 27
		local statName = label(frame, attribute[1], attribute[2], UDim2.fromOffset(16, y), UDim2.new(1, -82, 0, 21), 13, muted)
		statName.TextXAlignment = Enum.TextXAlignment.Left
		label(frame, attribute[1] .. "Value", tostring(player.attributes[attribute[1]]),
			UDim2.new(1, -62, 0, y), UDim2.fromOffset(46, 21), 17)
	end
	local lock = label(frame, "Ownership", "LOCKED", UDim2.fromOffset(12, 331), UDim2.new(1, -24, 0, 19), 11, muted)
	local buy = button(frame, "Buy", "BUY", UDim2.new(0, 12, 1, -49), UDim2.new(1, -24, 0, 38), accent)
	table.insert(cards, { offer = offer, frame = frame, buy = buy, lock = lock })
	buy.Activated:Connect(function()
		if pending or not state.ready or state.owned[offer.id] or state.balance < offer.price then return end
		request("Buy", offer.id, player.name)
	end)
end
request = function(action, id, name)
	if pending then return end
	pending = true
	status.Text = action == "Buy" and "Unlocking player…" or "Loading wallet…"
	render()
	local ok, result = pcall(function()
		local remote = ReplicatedStorage:WaitForChild("HoopsShop", 10)
		if not remote then error("Shop server unavailable") end
		return remote:InvokeServer(action, id)
	end)
	pending = false
	if ok and type(result) == "table" then
		state = result
		local messages = {
			READY = result.preview and "Studio trial: $1,000,000 test money. Purchases reset when you stop Play." or "Buy with game cash. Unlocks are saved to your account.",
			PURCHASED = (name or "Player") .. " unlocked!" .. (result.preview and " (Studio trial)" or ""),
			OWNED = "You already own this player. No money spent.",
			INSUFFICIENT = "Not enough cash. Save up to unlock this player.",
			BUSY = "Please wait a moment, then try again.",
			UNAVAILABLE = "Shop unavailable. Reopen the shop to check your balance and unlocks.",
			INVALID = "This player is unavailable.",
		}
		status.Text = messages[result.code] or "Reopen the shop to check your unlocks."
	else
		state.ready = false
		status.Text = "Could not reach the shop. Reopen it to check your balance and unlocks."
	end
	render()
end
local function fit()
	local width = math.max(1, scroll.AbsoluteSize.X - 16)
	local columns = math.clamp(math.floor((width + 16) / 256), 1, 4)
	grid.CellSize = UDim2.fromOffset(math.floor((width - (columns - 1) * 16) / columns), 408)
end
scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
fit()
local mainGui, mainWasEnabled
local function closeShop()
	page.Visible = false
	playerGui:SetAttribute("HoopsPanel", nil)
	if mainGui and mainGui.Parent then mainGui.Enabled = mainWasEnabled end
	entry.Visible, lobbyMoney.Visible = true, true
	GuiService.SelectedObject = entry
end
entry.Activated:Connect(function()
	mainGui = playerGui:FindFirstChild("CollegeHoopsUI")
	if mainGui then mainWasEnabled = mainGui.Enabled; mainGui.Enabled = false end
	entry.Visible, lobbyMoney.Visible, page.Visible = false, false, true
	playerGui:SetAttribute("HoopsPanel", "Shop")
	GuiService.SelectedObject = hofTab
	task.spawn(request, "State")
end)
close.Activated:Connect(closeShop)
local function selectGroup(group)
	selectedGroup = group
	scroll.CanvasPosition = Vector2.zero
	render()
end
hofTab.Activated:Connect(function() selectGroup("HOF") end)
nonTab.Activated:Connect(function() selectGroup("NON-COLLEGE") end)
local input = UserInputService.InputBegan:Connect(function(key, processed)
	if not processed and page.Visible and (key.KeyCode == Enum.KeyCode.Escape or key.KeyCode == Enum.KeyCode.ButtonB) then closeShop() end
end)
-- Keep the lobby's Shop button out of the squad-building screen.
local function bindMain(object)
	if object.Name ~= "CollegeHoopsUI" then return end
	local function visibility()
		local inSquad = object:GetAttribute("PanelOpen") == true
		entry.Visible = not playerGui:GetAttribute("HoopsPanel") and not inSquad
		lobbyMoney.Visible = entry.Visible
	end
	object:GetAttributeChangedSignal("PanelOpen"):Connect(visibility)
	playerGui:GetAttributeChangedSignal("HoopsPanel"):Connect(visibility)
	visibility()
end
playerGui.ChildAdded:Connect(bindMain)
for _, object in ipairs(playerGui:GetChildren()) do bindMain(object) end
gui.Destroying:Connect(function() input:Disconnect() end)
Players.LocalPlayer:GetAttributeChangedSignal("HoopsCash"):Connect(function()
	state.balance = Players.LocalPlayer:GetAttribute("HoopsCash") or state.balance
	render()
end)
render()
task.spawn(request, "State")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
