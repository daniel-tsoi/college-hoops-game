    { ["acquisition"] = "DIRECT_PURCHASE", ["attributes"] = { ["defense"] = 94, ["dribbling"] = 95, ["shooting"] = 90, ["speed"] = 95, ["stamina"] = 99 }, ["eligiblePositions"] = { "SF", "PF", "PG" }, ["id"] = "non-college-lebron-james", ["name"] = "LeBron James", ["overall"] = 105, ["position"] = "SF", ["rarity"] = Rarity.AllStar, ["ratingStatus"] = "MANUAL_ESTIMATE", ["sourceType"] = "NON_COLLEGE", ["statMultiplier"] = 1.2, ["sourceUrls"] = { "https://www.nba.com/player/2544/lebron-james/bio" }, ["ratingModelVersion"] = "manual-special-archetypes-v1", ["dataConfidence"] = "LOW", ["speedBasis"] = "MANUAL_ARCHETYPE_NOT_MEASURED", ["playerId"] = "legacy-lebron-james", ["variant"] = "NON_COLLEGE", ["positionConfidence"] = "ESTIMATED", ["defaultUnlocked"] = false },
    { ["acquisition"] = "DIRECT_PURCHASE", ["attributes"] = { ["defense"] = 76, ["dribbling"] = 98, ["shooting"] = 96, ["speed"] = 78, ["stamina"] = 94 }, ["eligiblePositions"] = { "PG", "SG", "SF" }, ["id"] = "non-college-luka-doncic", ["name"] = "Luka Doncic", ["overall"] = 103, ["position"] = "PG", ["rarity"] = Rarity.AllStar, ["ratingStatus"] = "MANUAL_ESTIMATE", ["sourceType"] = "NON_COLLEGE", ["statMultiplier"] = 1.2, ["sourceUrls"] = { "https://www.realmadrid.com/en-US/the-club/history/basketball-legends/luka-doncic/" }, ["ratingModelVersion"] = "manual-special-archetypes-v1", ["dataConfidence"] = "LOW", ["speedBasis"] = "MANUAL_ARCHETYPE_NOT_MEASURED", ["playerId"] = "legacy-luka-doncic", ["variant"] = "NON_COLLEGE", ["positionConfidence"] = "ESTIMATED", ["defaultUnlocked"] = false },
