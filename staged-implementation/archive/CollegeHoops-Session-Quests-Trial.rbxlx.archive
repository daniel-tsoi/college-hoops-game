					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">76fd9bb943d9ca240aade5c0000003de</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="11">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Exact, mutually exclusive tier configuration for the future server summon service.
-- A uniform integer in [1, 800] has ONE HOF result, EIGHT All-Star results,
-- and 791 ordinary results. Never roll independent HOF and All-Star checks.
-- This ModuleScript does not draw a random number, charge, spawn, or grant a card.
export type Outcome = "HOF" | "All-Star" | "Ordinary"
export type TicketRange = { first: number, last: number, count: number }
local Tickets: { [Outcome]: TicketRange } = {
    HOF = { first = 1, last = 1, count = 1 },
    ["All-Star"] = { first = 2, last = 9, count = 8 },
    Ordinary = { first = 10, last = 800, count = 791 },
}
for _, range in Tickets do table.freeze(range) end
local HOFCardIds = table.freeze({
    "hof-magic-johnson-1978-79", "hof-michael-jordan-1983-84",
    "hof-shaquille-oneal-1991-92", "hof-oscar-robertson-1959-60",
    "hof-pete-maravich-1969-70", "hof-jayson-tatum-2016-17",
    "hof-derrick-rose-2007-08", "hof-kyrie-irving-2010-11",
})
return table.freeze({
    Denominator = 800,
    Tickets = table.freeze(Tickets),
    HOFChance = 1 / 800,
    AllStarChance = 1 / 100,
    HOFCardIds = HOFCardIds,
    HOFSelection = "UNIFORM", -- a specific HOF card is 1/6400 overall
    AllStarPool = "CURRENT_SCHOOL_SEASON",
    RequireNonEmptyAllStarPool = true,
    RequireReleaseReadySchoolSeason = true,
    EmptyPoolPolicy = "BLOCK_BEFORE_CHARGE_OR_RANDOM_DRAW",
    ExcludedSourceTypes = table.freeze({ "NON_COLLEGE" }),
})
]]></ProtectedString>
					<string name="ScriptGuid">{3ab586cc-5d03-465a-a87c-2bfd95c91a7c}</string>
