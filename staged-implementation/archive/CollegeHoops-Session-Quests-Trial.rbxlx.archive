				<UniqueId name="UniqueId">76fd9bb943d9ca240aade5c0000003e8</UniqueId>
			</Properties>
			<Item class="LocalScript" referent="17">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Staged implementation / Feature 1: standalone interface only.
-- Paste into a LocalScript named HoopsUI under StarterPlayerScripts.
-- Studio preview counters are disposable. Real actions require a future server feature.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
if playerGui:FindFirstChild("CollegeHoopsUI") then
	return -- Prevent duplicate copies of this interface.
end
local preview = RunService:IsStudio()
local colors = {
	background = Color3.fromRGB(15, 20, 29),
	panel = Color3.fromRGB(25, 33, 46),
	button = Color3.fromRGB(43, 56, 74),
	accent = Color3.fromRGB(100, 229, 170),
	danger = Color3.fromRGB(242, 135, 135),
	text = Color3.fromRGB(241, 244, 249),
	muted = Color3.fromRGB(168, 181, 199),
}
local function create(className, parent, properties)
	local object = Instance.new(className)
	for key, value in pairs(properties) do
		object[key] = value
	end
	object.Parent = parent
	return object
end
local function round(object)
	create("UICorner", object, { CornerRadius = UDim.new(0, 3) })
end
local gui = create("ScreenGui", playerGui, {
	Name = "CollegeHoopsUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 10,
	ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
})
local background = create("Frame", gui, {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Visible = false,
	BorderSizePixel = 0,
})
background:GetPropertyChangedSignal("Visible"):Connect(function()
	gui:SetAttribute("PanelOpen", background.Visible)
end)
local build = create("TextButton", gui, {
	Name = "Build",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.new(1, -32, 0, 64),
	Text = "Build Your Squad",
	Font = Enum.Font.GothamBold,
	TextSize = 20,
	BackgroundColor3 = Color3.fromRGB(8, 12, 12),
	TextColor3 = colors.text,
	BorderSizePixel = 0,
	Visible = true,
	Selectable = true,
})
round(build)
create("UISizeConstraint", build, { MaxSize = Vector2.new(320, 64) })
create("UIStroke", build, {
	ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	Thickness = 2,
	Color = Color3.fromRGB(83, 220, 133),
})
-- A fixed design canvas scales to the available safe area: no scrolling.
local canvas = create("Frame", background, {
	Name = "SquadCanvas",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(1120, 680),
	BackgroundTransparency = 1,
})
local canvasScale = create("UIScale", canvas, { Scale = 1 })
local function fitCanvas()
	local size = background.AbsoluteSize
	canvasScale.Scale = math.min(size.X / 1120, size.Y / 680)
end
local resizeConnection = background:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitCanvas)
fitCanvas()
local function textAt(parent, name, text, x, y, width, height, size, color)
	return create("TextLabel", parent, {
		Name = name,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color or colors.text,
		Font = Enum.Font.GothamBold,
		TextWrapped = true,
		TextStrokeTransparency = 0.5,
	})
end
local function outline(object, color)
	create("UIStroke", object, {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Thickness = 2,
		Color = color or colors.accent,
	})
end
textAt(canvas, "Title", "BUILD YOUR\nSQUAD", 24, 18, 280, 100, 38)
textAt(canvas, "Mode", preview and "STUDIO UI PREVIEW" or "UI ONLY", 24, 120, 280, 24, 14, colors.accent)
local counters = textAt(canvas, "Counters", "", 24, 147, 280, 40, 15)
local actions = create("Frame", canvas, {
	Name = "Actions",
	Position = UDim2.fromOffset(44, 202),
	Size = UDim2.fromOffset(240, 422),
	BackgroundTransparency = 1,
})
create("UIListLayout", actions, { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
local buttons = {}
local actionNames = { "Roll", "Reroll", "Refresh", "Restart", "Exit" }
for index, name in ipairs(actionNames) do
	local button = create("TextButton", actions, {
		Name = name:gsub(" ", ""),
		LayoutOrder = index,
		Size = UDim2.fromOffset(240, 50),
		Text = name:upper(),
		BackgroundColor3 = Color3.fromRGB(8, 12, 12),
		BackgroundTransparency = 0.12,
		TextColor3 = colors.text,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Selectable = true,
	})
	round(button)
	outline(button, (name == "Restart" or name == "Exit") and colors.danger or colors.accent)
	buttons[name] = button
end
textAt(canvas, "Overall", "TEAM OVR: —   |   CHEMISTRY: —", 340, 16, 748, 40, 26)
textAt(canvas, "SchoolSeason", "School & season: awaiting game system", 340, 61, 748, 28, 16)
local court = create("Frame", canvas, {
	Name = "CurrentPlayers",
	Position = UDim2.fromOffset(340, 100),
	Size = UDim2.fromOffset(748, 366),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
})
outline(court)
local lineup = textAt(court, "LineupCount", "", 12, 6, 724, 26, 17)
local positions = { "PG", "SG", "SF", "PF", "C" }
local slotLocations =
	{ Vector2.new(184, 44), Vector2.new(414, 44), Vector2.new(70, 204), Vector2.new(299, 204), Vector2.new(528, 204) }
local slots = {}
for index, position in ipairs(positions) do
	local point = slotLocations[index]
	local card = textAt(court, position, position .. "\n\nEMPTY", point.X, point.Y, 150, 140, 21)
	card.BackgroundColor3 = colors.panel
	card.BackgroundTransparency = 0.24
	card.BorderSizePixel = 0
	round(card)
	outline(card, colors.muted)
	slots[index] = card
end
textAt(canvas, "CandidatesTitle", "CHOOSE A PLAYER  |  ONE PER POSITION", 340, 477, 748, 24, 16)
local candidateButtons = {}
for index, position in ipairs(positions) do
	local card = create("TextButton", canvas, {
		Name = "Candidate" .. position,
		Position = UDim2.fromOffset(340 + (index - 1) * 152, 509),
		Size = UDim2.fromOffset(140, 100),
		Text = position,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextWrapped = true,
		TextColor3 = colors.text,
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.16,
		BorderSizePixel = 0,
		Selectable = true,
		AutoButtonColor = true,
	})
	round(card)
	outline(card, colors.muted)
	candidateButtons[index] = card
end
local reveal = textAt(canvas, "SelectedPlayer", "Select a candidate", 24, 522, 280, 74, 16)
local status = textAt(
	canvas,
	"Status",
	"Choose a candidate to fill their position. Preview players only; nothing is saved.",
	340,
	622,
	748,
	46,
	16
)
status.BackgroundColor3 = colors.panel
status.BackgroundTransparency = 0.15
status.BorderSizePixel = 0

local overlay = create("TextButton", gui, {
	Name = "ConfirmationOverlay",
	Size = UDim2.fromScale(1, 1),
	Text = "",
	BackgroundColor3 = Color3.new(),
	BackgroundTransparency = 0.25,
	AutoButtonColor = false,
	Selectable = false,
	Visible = false,
	ZIndex = 20,
	Modal = true,
})
local dialog = create("Frame", overlay, {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(1, -32, 0, 224),
	BackgroundColor3 = colors.panel,
	BorderSizePixel = 0,
	ZIndex = 21,
})
round(dialog)
create("UISizeConstraint", dialog, { MaxSize = Vector2.new(460, 224) })
local dialogText = create("TextLabel", dialog, {
	Position = UDim2.fromOffset(16, 16),
	Size = UDim2.new(1, -32, 0, 124),
	BackgroundTransparency = 1,
	TextColor3 = colors.text,
	TextSize = 18,
	Font = Enum.Font.GothamMedium,
	TextWrapped = true,
	ZIndex = 22,
	Text = "RESTART PREVIEW?\n\nClears this UI preview and sets Rerolls and Refreshes to 1 each. No real team or collection exists yet.",
})
local function dialogButton(text, x)
	local button = create("TextButton", dialog, {
		Position = UDim2.new(x, 12, 1, -68),
		Size = UDim2.new(0.5, -24, 0, 52),
		Text = text,
		TextColor3 = colors.text,
		BackgroundColor3 = colors.button,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		BorderSizePixel = 0,
		ZIndex = 22,
		Selectable = true,
	})
	round(button)
	return button
end
local cancel = dialogButton("CANCEL", 0)
local confirm = dialogButton("RESTART", 0.5)
local freeRerolls, freeRefreshes = 1, 1
local spendingReward = false
local bonusRerolls = Players.LocalPlayer:GetAttribute("QuestRerolls") or 0
local bonusRefreshes = Players.LocalPlayer:GetAttribute("QuestRefreshes") or 0
local finished = false
local pendingAction, returnFocus, selected = nil, nil, nil
local squad, candidates = {}, {}
-- Disposable UI fixtures, not the real roster, ratings, or drop odds.
local rng = Random.new()
local previewSequence = 0
local function newPreviewPlayer(position)
	previewSequence += 1
	return { name = position .. " Prospect " .. rng:NextInteger(100, 999), id = previewSequence }
end
local function refillCandidates()
	for index, position in ipairs(positions) do
		candidates[index] = newPreviewPlayer(position)
	end
end
local function countFilled()
	local count = 0
	for index = 1, 5 do
		if squad[index] then
			count += 1
		end
	end
	return count
end
local function setModal(open)
	overlay.Visible = open
	for _, button in pairs(buttons) do
		button.Selectable = not open
		button.Active = not open
	end
	for _, button in ipairs(candidateButtons) do
		button.Selectable = not open
		button.Active = not open
	end
end
local function render()
	local filled = countFilled()
	counters.Text = preview and string.format("Rerolls: %d free + %d quest\nRefreshes: %d free + %d quest", freeRerolls, bonusRerolls, freeRefreshes, bonusRefreshes)
		or "Free actions: awaiting server"
	buttons.Reroll.Text = filled == 5 and (finished and "FINISHED" or "FINISH")
		or (preview and string.format("REROLL  |  %d LEFT", freeRerolls + bonusRerolls) or "REROLL")
	buttons.Refresh.Text = preview and string.format("REFRESH  |  %d LEFT", freeRefreshes + bonusRefreshes) or "REFRESH"
	lineup.Text = string.format("CURRENT PLAYERS  |  %d / 5 preview slots", filled)
	for index, slot in ipairs(slots) do
		local player = squad[index]
		slot.Text = positions[index] .. "\n\n" .. (player and player.name or "EMPTY")
		slot.TextColor3 = player and colors.accent or colors.text
		local card = candidateButtons[index]
		card.Text = positions[index]
			.. "\n"
			.. (preview and candidates[index].name or "Awaiting roster")
			.. (selected == index and "\nSELECTED" or "")
		card.BackgroundColor3 = selected == index and colors.button or colors.panel
	end
	reveal.Text = selected and ("SELECTED: " .. positions[selected] .. "\n" .. squad[selected].name)
		or "Select a candidate"
end
local function closeDialog()
	setModal(false)
	pendingAction = nil
	GuiService.SelectedObject = returnFocus
end
local function openDialog(action, text)
	pendingAction = action
	returnFocus = GuiService.SelectedObject
	dialogText.Text = text
	confirm.Text = action == "Restart" and "RESTART" or "FINISH PREVIEW"
	setModal(true)
	GuiService.SelectedObject = cancel
end
cancel.NextSelectionLeft = confirm
cancel.NextSelectionRight = confirm
cancel.NextSelectionUp = confirm
cancel.NextSelectionDown = confirm
confirm.NextSelectionLeft = cancel
confirm.NextSelectionRight = cancel
confirm.NextSelectionUp = cancel
confirm.NextSelectionDown = cancel
local function spendQuestReward(action)
	spendingReward = true
	status.Text = "Using quest reward…"
	local ok, result = pcall(function()
		local remote = game:GetService("ReplicatedStorage"):WaitForChild("HoopsShop", 10)
		if not remote then error("Reward server unavailable") end
		return remote:InvokeServer(action)
	end)
	spendingReward = false
	if ok and (result.code == "SPENT" or result.code == "RESET") then
		bonusRerolls, bonusRefreshes = result.rerolls, result.refreshes
		freeRerolls = result.previewFreeRerolls
		return true
	end
	status.Text = ok and result.code == "EMPTY" and "No quest rewards left. Play longer and claim a milestone."
		or "Could not use a quest reward. Please try again shortly."
	render()
	return false
end
local function restartPreview()
	if not spendQuestReward("PreviewRestart") then return end
	freeRerolls, freeRefreshes = 1, 1
	squad, selected, finished = {}, nil, false
	refillCandidates()
	status.Text = "Preview restarted. Choose a player for each position. Free counters reset to 1."
	render()
end
local function canEdit()
	if spendingReward or overlay.Visible or not background.Visible then
		return false
	end
	if not preview then
		status.Text = "UI ready. Real roster actions need the later server stage."
		return false
	end
	if finished then
		status.Text = "Preview finished. Restart to test another squad."
		return false
	end
	return true
end
local function chooseCandidate(index)
	if not canEdit() then
		return
	end
	selected = index
	-- Candidate selection immediately accepts that preview player into its position.
	squad[index] = candidates[index]
	status.Text = countFilled() == 5 and "All five players chosen. Press Finish to end this preview."
		or (positions[index] .. " filled. Choose another position, or Reroll this player.")
	render()
end
for index, button in ipairs(candidateButtons) do
	button.Activated:Connect(function()
		chooseCandidate(index)
	end)
end
cancel.Activated:Connect(closeDialog)
confirm.Activated:Connect(function()
	if not overlay.Visible then
		return
	end
	local action = pendingAction
	closeDialog()
	if action == "Restart" then
		restartPreview()
	elseif action == "Finish" and countFilled() == 5 and not finished then
		finished = true
		status.Text = "Preview finished. No cards or team were saved. Restart to test again."
		render()
	end
end)
for name, button in pairs(buttons) do
	button.Activated:Connect(function()
		if spendingReward or overlay.Visible or not background.Visible then
			return
		end
		if name == "Exit" then
			background.Visible = false
			build.Visible = true
			GuiService.SelectedObject = build
			return
		end
		if name == "Restart" and preview then
			if countFilled() > 0 and not finished then
				openDialog(
					"Restart",
					"RESTART PREVIEW?\n\nDiscard all five-position preview progress and candidates. Both free counters reset to 1. No permanent collection is affected."
				)
			else
				restartPreview()
			end
			return
		end
		if not canEdit() then
			return
		end
		if name == "Roll" then
			for index = 1, 5 do
				if not squad[index] then
					chooseCandidate(index)
					return
				end
			end
			status.Text = "All positions are filled. Press Finish."
		elseif name == "Reroll" then
			-- Finish takes priority over spending the Reroll resource.
			if countFilled() == 5 then
				openDialog(
					"Finish",
					"FINISH PREVIEW?\n\nAll five positions are filled. End this UI test? Nothing is saved in this stage."
				)
				return
			end
			if not selected then
				status.Text = "Choose a candidate first so Reroll knows which player to replace."
				return
			end
			if not spendQuestReward("PreviewReroll") then return end
			candidates[selected] = newPreviewPlayer(positions[selected])
			squad[selected] = candidates[selected]
			status.Text = "Selected player replaced and automatically placed in the squad."
			render()
		elseif name == "Refresh" then
			if freeRefreshes > 0 then
				freeRefreshes -= 1
			elseif not spendQuestReward("SpendRefresh") then
				return
			end
			refillCandidates()
			status.Text = "Five preview candidates refreshed, one per position. Current squad preserved."
			render()
		end
	end)
end
refillCandidates()
Players.LocalPlayer:GetAttributeChangedSignal("QuestRerolls"):Connect(function()
	bonusRerolls = Players.LocalPlayer:GetAttribute("QuestRerolls") or 0
	render()
end)
Players.LocalPlayer:GetAttributeChangedSignal("QuestRefreshes"):Connect(function()
	bonusRefreshes = Players.LocalPlayer:GetAttribute("QuestRefreshes") or 0
	render()
end)
build.Activated:Connect(function()
	build.Visible = false
	background.Visible = true
	GuiService.SelectedObject = buttons.Roll
end)
local inputConnection = UserInputService.InputBegan:Connect(function(input)
	if overlay.Visible and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
		closeDialog()
	end
end)
gui.Destroying:Connect(function()
	inputConnection:Disconnect()
	resizeConnection:Disconnect()
end)
render()
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{e259db4d-a245-468f-b4d1-951e244500d5}</string>
