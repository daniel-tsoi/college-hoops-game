    { ["acquisition"] = "DIRECT_PURCHASE", ["attributes"] = { ["defense"] = 94, ["dribbling"] = 95, ["shooting"] = 90, ["speed"] = 95, ["stamina"] = 99 }, ["eligiblePositions"] = { "SF", "PF", "PG" }, ["id"] = "non-college-lebron-james", ["name"] = "LeBron James", ["overall"] = 105, ["position"] = "SF", ["rarity"] = Rarity.AllStar, ["ratingStatus"] = "MANUAL_ESTIMATE", ["sourceType"] = "NON_COLLEGE", ["statMultiplier"] = 1.2, ["sourceUrls"] = { "https://www.nba.com/player/2544/lebron-james/bio" }, ["ratingModelVersion"] = "manual-special-archetypes-v1", ["dataConfidence"] = "LOW", ["speedBasis"] = "MANUAL_ARCHETYPE_NOT_MEASURED", ["playerId"] = "legacy-lebron-james", ["variant"] = "NON_COLLEGE", ["positionConfidence"] = "ESTIMATED", ["defaultUnlocked"] = false },
